#import, file "../src/entropy/coefficient_block.zi";
#import, file "../src/entropy/coefficient_cdfs.zi";
#import, file "../src/entropy/coefficient_cdf_symbols.zi";
#import, file "../src/entropy/range.zi";
#import, file "../src/transform/quantization.zi";

BlockIsZero :: (block: *CoefficientBlock) -> bool {
    if block.eob != 0 || block.level != 0 || block.dc_category != 0 ||
        block.coded_width != 0 || block.coded_height != 0 { return false }
    for i: 0..1023 { if block.quant[i] != 0 { return false } }
    return true
}

CoefficientBlockBoundaries :: () -> s32 {
    data: [16]u8
    cdfs := NewCoefficientCDFs(0)
    decoder := NewRange(BorrowBytes(data[:]), 0, 16)
    missing: *RangeDecoder; missing_cdfs: *CoefficientCDFs
    block := ReadNonzeroCoefficients(missing, *cdfs, 4, 4, 0, 0, 0)
    if block.error.code != InvalidInput || !BlockIsZero(*block) { return 1 }
    block = ReadNonzeroCoefficients(*decoder, missing_cdfs, 4, 4, 0, 0, 0)
    if block.error.code != InvalidInput || !BlockIsZero(*block) { return 2 }
    shapes: [16]s32 = .[-2147483647,4,2147483647,4,0,4,3,4,4,0,64,4,4,64,8,64]
    for i: 0..7 {
        block = ReadNonzeroCoefficients(*decoder, *cdfs, shapes[i * 2], shapes[i * 2 + 1], 0, 0, 0)
        if block.error.code != InvalidInput || !BlockIsZero(*block) { return 3 }
        skip := ReadCoefficientSkip(*decoder, *cdfs, shapes[i * 2], shapes[i * 2 + 1], 0, 0)
        if skip.error.code != InvalidInput || skip.value != 0 { return 4 }
    }
    for i: 0..7 {
        cls: s32; plane: s32; dc: s32; width: s32 = 4
        if i == 0 { cls = -1 }
        if i == 1 { cls = 3 }
        if i == 2 { plane = -1 }
        if i == 3 { plane = 2 }
        if i == 4 { dc = -1 }
        if i == 5 { dc = 3 }
        if i == 6 { width = 32; cls = 1 }
        if i == 7 { width = 32; cls = 2 }
        block = ReadNonzeroCoefficients(*decoder, *cdfs, width, 8, cls, plane, dc)
        if block.error.code != InvalidInput || !BlockIsZero(*block) { return 5 }
    }
    for i: 0..5 {
        plane: s32; context: s32
        if i == 0 { plane = -1 }
        if i == 1 { plane = 2 }
        if i == 2 { context = -1 }
        if i == 3 { context = 13 }
        if i == 4 { context = 7 }
        if i == 5 { plane = 1; context = 6 }
        skip := ReadCoefficientSkip(*decoder, *cdfs, 4, 4, plane, context)
        if skip.error.code != InvalidInput || skip.value != 0 { return 6 }
    }
    token: Cancellation; Cancel(*token)
    block = ReadNonzeroCoefficients(*decoder, *cdfs, 4, 4, 0, 0, 0, *token)
    if block.error.code != DecodeCancelled || !BlockIsZero(*block) { return 7 }
    if ReadCoefficientSkip(*decoder, *cdfs, 4, 4, 0, 0, *token).error.code != DecodeCancelled { return 8 }
    fresh := NewCoefficientCDFs(0)
    for i: 0..3834 { if cdfs.values[i] != fresh.values[i] { return 9 } }
    if decoder.max_bits != 113 || RangeBitPosition(*decoder) != 15 { return 10 }
    decoder = NewRange(BorrowBytes(data[:]), 0, 0)
    block = ReadNonzeroCoefficients(*decoder, *cdfs, 4, 4, 0, 0, 0)
    if block.error.code != TruncatedInput || !BlockIsZero(*block) { return 11 }
    // Seeded malformed/boundary buffers must terminate deterministically. They
    // may describe valid component syntax; failures commit no partial block.
    seed: u32 = 4289041
    for sample: 0..31 {
        for i: 0..15 { seed = seed * 1664525 + 1013904223; data[i] = cast(u8)(seed >> 24) }
        length := sample % 16 + 1
        a := NewRange(BorrowBytes(data[:]), 0, length)
        b := NewRange(BorrowBytes(data[:]), 0, length)
        ca := NewCoefficientCDFs(61); cb := NewCoefficientCDFs(61)
        ba := ReadNonzeroCoefficients(*a, *ca, 4, 4, 0, 0, 0)
        bb := ReadNonzeroCoefficients(*b, *cb, 4, 4, 0, 0, 0)
        if ba.error.code != bb.error.code || ba.error.offset != bb.error.offset { return 12 }
        if ba.error.code != DecodeOK && (!BlockIsZero(*ba) || !BlockIsZero(*bb)) { return 13 }
        if ba.eob != bb.eob || ba.level != bb.level || ba.dc_category != bb.dc_category { return 14 }
        for i: 0..1023 { if ba.quant[i] != bb.quant[i] { return 15 } }
        for i: 0..3834 { if ca.values[i] != cb.values[i] { return 16 } }
    }
    // DecodeDequantizedCoefficients checks its target before reading.
    samples: [16]s32
    target: CoefficientDequant; target.samples = samples[:]; target.dc = 4; target.ac = 4; target.depth = 8
    scratch: CoefficientScratch; missing_target: *CoefficientDequant
    decoder = NewRange(BorrowBytes(data[:]), 0, 16)
    for i: 0..4 {
        bad := target
        if i == 1 { bad.samples = samples[:15] }
        if i == 2 { bad.depth = 9 }
        if i == 3 { bad.dc = -1 }
        if i == 4 { bad.ac = -1 }
        summary: CoefficientSummary
        if i == 0 { summary = DecodeDequantizedCoefficients(*decoder, *cdfs, 4, 4, 0, 0, 0, missing_target, *scratch) }
        else { summary = DecodeDequantizedCoefficients(*decoder, *cdfs, 4, 4, 0, 0, 0, *bad, *scratch) }
        if summary.error.code != InvalidInput || RangeBitPosition(*decoder) != 15 { return 17 }
    }
    if DecodeDequantizedCoefficients(*decoder, *cdfs, 4, 4, 0, 0, 0, *target, *scratch,
        *token).error.code != DecodeCancelled {
        return 18
    }
    return 0
}

// DecodeDequantizedCoefficients on a block's stream against
// ReadNonzeroCoefficients and then DequantizeBlock with flat weights: the
// same summary, range position and CDFs; a box holding every nonzero
// coefficient; the dequantized values in that box rounded up to multiples of
// 4; and every other sample left as it was.
DequantizedMatches :: (bytes: []u8, disable: bool, q: s32, skip_context: s32, width: s32, height: s32, tx_class: s32,
    plane: s32, dc_context: s32, qindex: s32, depth: s32) -> s32 {
    cdfs := NewCoefficientCDFs(q); fused_cdfs := NewCoefficientCDFs(q)
    decoder := NewRange(BorrowBytes(bytes), 0, bytes.count, disable)
    fused := NewRange(BorrowBytes(bytes), 0, bytes.count, disable)
    if ReadCoefficientSkip(*decoder, *cdfs, width, height, plane, skip_context).value != 0 ||
        ReadCoefficientSkip(*fused, *fused_cdfs, width, height, plane, skip_context).value != 0 {
        return 1
    }
    block := ReadNonzeroCoefficients(*decoder, *cdfs, width, height, tx_class, plane, dc_context)
    cw := ifx width < 32 then width else 32; ch := ifx height < 32 then height else 32
    flat: [1]u8
    expected := DequantizeBlock(block.quant[:cw * ch], width, height, qindex, 0, 0, depth, flat[:0])
    steps := GetQuantizationSteps(qindex, 0, 0, depth)
    if block.error.code != DecodeOK || expected.error.code != DecodeOK || steps.error.code != DecodeOK { return 2 }
    samples: [4097]s32
    for i: 0..4096 { samples[i] = 1234567 }
    target: CoefficientDequant
    target.samples = samples[:width * height]; target.dc = steps.dc; target.ac = steps.ac; target.depth = depth
    scratch: CoefficientScratch
    summary := DecodeDequantizedCoefficients(*fused, *fused_cdfs, width, height, tx_class, plane, dc_context, *target,
        *scratch)
    if summary.error.code != DecodeOK || summary.eob != block.eob || summary.level != block.level ||
        summary.dc_category != block.dc_category || summary.rows < 1 || summary.rows > ch || summary.columns < 1 ||
        summary.columns > cw {
        return 3
    }
    if RangeBitPosition(*decoder) != RangeBitPosition(*fused) { return 4 }
    for i: 0..3834 { if cdfs.values[i] != fused_cdfs.values[i] { return 5 } }
    fill_rows := (cast(s64)summary.rows + 3) & -4; fill_columns := (cast(s64)summary.columns + 3) & -4
    for i: 0..cast(s64)height - 1 { for j: 0..cast(s64)width - 1 {
        at := i * width + j
        if i < fill_rows && j < fill_columns {
            if samples[at] != expected.samples[at] { return 6 }
        } else if samples[at] != 1234567 || expected.samples[at] != 0 {
            return 7
        }
    } }
    for i: cast(s64)width * height..4096 { if samples[i] != 1234567 { return 8 } }
    return 0
}
