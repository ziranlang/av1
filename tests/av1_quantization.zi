#import, file "../src/transform/quantization.zi";

QuantizationBoundaries :: () -> s32 {
    if ResolveQuantizerIndex(20, 90, false, false, false, 0).value != 20 { return 1 }
    if ResolveQuantizerIndex(20, 90, true, false, false, 0).value != 90 { return 2 }
    if ResolveQuantizerIndex(20, 90, true, true, false, 0).value != 20 { return 3 }
    if ResolveQuantizerIndex(20, 90, true, false, true, -255).value != 0 { return 4 }
    if ResolveQuantizerIndex(20, 90, true, true, true, 255).value != 255 { return 5 }
    if ResolveQuantizerIndex(-1, 0, false, false, false, 0).error.code != InvalidInput { return 6 }
    if ResolveQuantizerIndex(256, 0, false, false, false, 0).error.code != InvalidInput { return 7 }
    if ResolveQuantizerIndex(0, -1, false, false, false, 0).error.code != InvalidInput { return 8 }
    if ResolveQuantizerIndex(0, 256, false, false, false, 0).error.code != InvalidInput { return 9 }
    if ResolveQuantizerIndex(0, 0, false, false, true, -256).error.code != InvalidInput { return 10 }
    if ResolveQuantizerIndex(0, 0, false, false, true, 256).error.code != InvalidInput { return 11 }
    if GetQuantizationSteps(-1, 0, 0, 8).error.code != InvalidInput { return 12 }
    if GetQuantizationSteps(256, 0, 0, 8).error.code != InvalidInput { return 13 }
    if GetQuantizationSteps(0, -65, 0, 8).error.code != InvalidInput { return 14 }
    if GetQuantizationSteps(0, 64, 0, 8).error.code != InvalidInput { return 15 }
    if GetQuantizationSteps(0, 0, -65, 8).error.code != InvalidInput { return 16 }
    if GetQuantizationSteps(0, 0, 64, 8).error.code != InvalidInput { return 17 }
    if GetQuantizationSteps(0, 0, 0, 9).error.code != InvalidInput { return 18 }
    for d: 0..2 {
        steps := GetQuantizationSteps(0, 0, 0, 8 + cast(s32)d * 2)
        if steps.error.code != DecodeOK || steps.dc != 4 || steps.ac != 4 { return 19 }
    }
    quant: [16]s32; weights: [17]u8
    for i: 0..16 { weights[i] = 32 }
    quant[0] = -1; quant[1] = 1
    identity := DequantizeBlock(quant[:], 4, 4, 0, 0, 0, 8, weights[:0])
    if identity.error.code != DecodeOK || identity.samples[0] != -4 || identity.samples[1] != 4 { return 20 }
    if DequantizeBlock(quant[:15], 4, 4, 0, 0, 0, 8, weights[:0]).error.code != InvalidInput { return 21 }
    if DequantizeBlock(quant[:], 4, 4, 0, 0, 0, 8, weights[:15]).error.code != InvalidInput { return 22 }
    if DequantizeBlock(quant[:], 4, 4, 0, 0, 0, 8, weights[:]).error.code != InvalidInput { return 23 }
    if DequantizeBlock(quant[:], -2147483648, 4, 0, 0, 0, 8, weights[:0]).error.code != InvalidInput { return 24 }
    if DequantizeBlock(quant[:], 4, 2147483647, 0, 0, 0, 8, weights[:0]).error.code != InvalidInput { return 25 }
    sides: [7]s32 = .[0,3,5,12,128,2147483647,-1]
    for i: 0..6 {
        if DequantizeBlock(quant[:], sides[i], 4, 0, 0, 0, 8, weights[:0]).error.code != InvalidInput { return 26 }
        if DequantizeBlock(quant[:], 4, sides[i], 0, 0, 0, 8, weights[:0]).error.code != InvalidInput { return 27 }
    }
    if DequantizeBlock(quant[:], 4, 32, 0, 0, 0, 8, weights[:0]).error.code != InvalidInput { return 28 }
    if DequantizeBlock(quant[:], 32, 4, 0, 0, 0, 8, weights[:0]).error.code != InvalidInput { return 29 }
    quant[15] = 1048576
    failed := DequantizeBlock(quant[:], 4, 4, 0, 0, 0, 8, weights[:0])
    if failed.error.code != InvalidInput || failed.width != 0 || failed.height != 0 { return 30 }
    for i: 0..4095 { if failed.samples[i] != 0 { return 31 } }
    quant[15] = -1048576
    if DequantizeBlock(quant[:], 4, 4, 0, 0, 0, 8, weights[:0]).error.code != InvalidInput { return 32 }
    quant[15] = 0; weights[15] = 0
    if DequantizeBlock(quant[:], 4, 4, 0, 0, 0, 8, weights[:16]).error.code != InvalidInput { return 33 }
    token: Cancellation; Cancel(*token)
    if ResolveQuantizerIndex(0, 0, false, false, false, 0, *token).error.code != DecodeCancelled { return 34 }
    if GetQuantizationSteps(0, 0, 0, 8, *token).error.code != DecodeCancelled { return 35 }
    cancelled := DequantizeBlock(quant[:], 4, 4, 0, 0, 0, 8, weights[:0], *token)
    if cancelled.error.code != DecodeCancelled || cancelled.width != 0 || cancelled.height != 0 { return 36 }
    for i: 0..4095 { if cancelled.samples[i] != 0 { return 37 } }
    return 0
}

// DequantizeSparseInto against DequantizeBlock with flat weights, on blocks of
// every size whose nonzero coefficients it is given in random order, and its
// input checks. Samples past the block keep their sentinel.
SparseDequantization :: () -> s32 {
    sizes: [38]s32 = .[4,4, 4,8, 8,4, 8,8, 8,16, 16,8, 16,16, 16,32, 32,16, 32,32, 32,64, 64,32, 64,64,
        4,16, 16,4, 8,32, 32,8, 16,64, 64,16]
    qindices: [6]s32 = .[0,1,20,128,200,255]
    deltas: [6]s32 = .[0,-64,63,-1,1,0]
    quant: [1024]s32; order: [1024]u16; samples: [4097]s32; flat: [1]u8
    seed: u32 = 2654435761
    for d: 0..2 { for s: 0..18 { for round: 0..5 {
        width := sizes[s * 2]; height := sizes[s * 2 + 1]; depth := 8 + cast(s32)d * 2
        cw := ifx width < 32 then width else 32; ch := ifx height < 32 then height else 32
        total := cw * ch
        seed = seed * 1664525 + 1013904223
        count: s32 = 0
        if round == 1 { count = 1 }
        if round == 2 { count = 3 }
        if round == 3 { count = total / 8 }
        if round == 4 { count = total }
        if round == 5 { count = cast(s32)(seed >> 8) % total + 1 }
        for i: 0..total - 1 { quant[i] = 0; order[i] = cast(u16)i }
        for i: 0..count - 1 {
            seed = seed * 1664525 + 1013904223
            j := cast(s32)i + cast(s32)((seed >> 8) % cast(u32)(total - cast(s32)i))
            swap := order[i]; order[i] = order[j]; order[j] = swap
            seed = seed * 1664525 + 1013904223
            kind := seed >> 29; random := cast(s32)((seed >> 4) % 1048575)
            level: s32 = 1 + random % 2048
            if kind == 0 { level = 1 }
            if kind == 1 { level = 1048575 }
            if kind == 2 { level = 1 + random }
            if kind == 3 { level = 0 }
            quant[order[i]] = ifx (seed & 1) != 0 then -level else level
        }
        for i: 0..4096 { samples[i] = 1234567 }
        qindex := qindices[round]; delta_dc := deltas[round]; delta_ac := deltas[5 - round]
        error := DequantizeSparseInto(quant[:total], order[:], count, width, height, qindex, delta_dc, delta_ac,
            depth, samples[:])
        expected := DequantizeBlock(quant[:total], width, height, qindex, delta_dc, delta_ac, depth, flat[:0])
        if error.code != DecodeOK || expected.error.code != DecodeOK { return 1 }
        for i: 0..width * height - 1 { if samples[i] != expected.samples[i] { return 2 } }
        for i: width * height..4096 { if samples[i] != 1234567 { return 3 } }
    } } }
    for i: 0..15 { quant[i] = 0; order[i] = cast(u16)i }
    quant[3] = -7
    if DequantizeSparseInto(quant[:16], order[:], -1, 4, 4, 0, 0, 0, 8, samples[:]).code != InvalidInput { return 4 }
    if DequantizeSparseInto(quant[:16], order[:], 17, 4, 4, 0, 0, 0, 8, samples[:]).code != InvalidInput { return 5 }
    if DequantizeSparseInto(quant[:16], order[:3], 4, 4, 4, 0, 0, 0, 8, samples[:]).code != InvalidInput { return 6 }
    if DequantizeSparseInto(quant[:15], order[:], 4, 4, 4, 0, 0, 0, 8, samples[:]).code != InvalidInput { return 7 }
    if DequantizeSparseInto(quant[:17], order[:], 4, 4, 4, 0, 0, 0, 8, samples[:]).code != InvalidInput { return 8 }
    if DequantizeSparseInto(quant[:16], order[:], 4, 4, 4, 0, 0, 0, 8, samples[:15]).code != InvalidInput { return 9 }
    if DequantizeSparseInto(quant[:16], order[:], 4, 2, 4, 0, 0, 0, 8, samples[:]).code != InvalidInput { return 10 }
    if DequantizeSparseInto(quant[:256], order[:], 4, 64, 4, 0, 0, 0, 8, samples[:]).code != InvalidInput { return 11 }
    if DequantizeSparseInto(quant[:16], order[:], 4, 4, 4, 256, 0, 0, 8, samples[:]).code != InvalidInput { return 12 }
    if DequantizeSparseInto(quant[:16], order[:], 4, 4, 4, 0, 0, 0, 9, samples[:]).code != InvalidInput { return 13 }
    order[2] = 16
    if DequantizeSparseInto(quant[:16], order[:], 4, 4, 4, 0, 0, 0, 8, samples[:]).code != InvalidInput { return 14 }
    order[2] = 2; quant[1] = 1048576
    if DequantizeSparseInto(quant[:16], order[:], 4, 4, 4, 0, 0, 0, 8, samples[:]).code != InvalidInput { return 15 }
    quant[1] = -1048576
    if DequantizeSparseInto(quant[:16], order[:], 4, 4, 4, 0, 0, 0, 8, samples[:]).code != InvalidInput { return 16 }
    // A coefficient outside the listed ones is taken as zero, as documented.
    quant[1] = 0; quant[9] = 5
    if DequantizeSparseInto(quant[:16], order[:], 4, 4, 4, 0, 0, 0, 8, samples[:]).code != DecodeOK ||
        samples[3] != -28 || samples[9] != 0 { return 17 }
    token: Cancellation; Cancel(*token)
    if DequantizeSparseInto(quant[:16], order[:], 4, 4, 4, 0, 0, 0, 8, samples[:], *token).code != DecodeCancelled { return 18 }
    return 0
}
