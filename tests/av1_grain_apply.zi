#import, file "../src/grain/grain_apply.zi";
#import, file "../src/grain/grain_params.zi";

GrainApplyBounds :: () -> s32 {
    if GrainStripeColumns(0) != 0 || GrainStripeColumns(1) != 34 || GrainStripeColumns(64) != 66 ||
        GrainStripeColumns(65) != 98 || GrainScratchCount(64) != 7128 { return 1 }
    luma: [2]u16 = .[123,256]; cb: [2]u16 = .[100,256]; cr: [1]u16 = .[200]
    scratch: [3672]s16
    input: GrainPlanes; input.y = luma[:1]; input.y_stride = 1
    input.width = 1; input.height = 1; input.monochrome = true
    input.subsampling_x = 1; input.subsampling_y = 1; input.bit_depth = 8
    p: FilmGrainParams
    // Without apply_grain the planes are already the output; no scratch is needed.
    if ApplyFilmGrain(input, p, scratch[:0]).code != DecodeOK || luma[0] != 123 { return 2 }
    input.width = 0
    if ApplyFilmGrain(input, p, scratch[:]).code != InvalidInput { return 3 }
    input.width = 1; input.height = 0
    if ApplyFilmGrain(input, p, scratch[:]).code != InvalidInput { return 4 }
    input.height = 2
    if ApplyFilmGrain(input, p, scratch[:]).code != InvalidInput { return 5 }
    input.height = 1; input.y_stride = 0
    if ApplyFilmGrain(input, p, scratch[:]).code != InvalidInput { return 6 }
    input.y_stride = 1; input.y = luma[:0]
    if ApplyFilmGrain(input, p, scratch[:]).code != InvalidInput { return 7 }
    input.y = luma[:1]; input.bit_depth = 9
    if ApplyFilmGrain(input, p, scratch[:]).code != InvalidInput { return 8 }
    input.bit_depth = 8; input.subsampling_y = 2
    if ApplyFilmGrain(input, p, scratch[:]).code != InvalidInput { return 9 }
    input.subsampling_y = 1; input.monochrome = false
    if ApplyFilmGrain(input, p, scratch[:]).code != InvalidInput { return 10 }
    input.u = cb[:1]; input.v = cr[:]; input.chroma_stride = 0
    if ApplyFilmGrain(input, p, scratch[:]).code != InvalidInput { return 11 }
    input.chroma_stride = 1; input.v = cr[:0]
    if ApplyFilmGrain(input, p, scratch[:]).code != InvalidInput { return 12 }
    input.v = cr[:]; p.apply_grain = true; p.scaling_shift = 7
    if ApplyFilmGrain(input, p, scratch[:]).code != InvalidInput { return 13 }
    p.scaling_shift = 8; p.ar_coeff_shift = 6; p.cb_offset = 512
    if ApplyFilmGrain(input, p, scratch[:]).code != InvalidInput { return 14 }
    p.cb_offset = 0; p.num_y_points = 15
    if ApplyFilmGrain(input, p, scratch[:]).code != InvalidInput { return 15 }
    p.num_y_points = 2; p.scaling_points_y[0] = 128; p.scaling_points_y[2] = 128
    if ApplyFilmGrain(input, p, scratch[:]).code != InvalidInput { return 16 }
    p.scaling_points_y[2] = 255
    if ApplyFilmGrain(input, p, scratch[:3671]).code != InvalidInput { return 17 }
    // Validation failures happen before the first write.
    if luma[0] != 123 || cb[0] != 100 || cr[0] != 200 { return 18 }
    token: Cancellation; Cancel(*token)
    if ApplyFilmGrain(input, p, scratch[:], *token).code != DecodeCancelled || luma[0] != 123 { return 19 }
    input.y = luma[1:2]
    if ApplyFilmGrain(input, p, scratch[:]).code != InvalidInput { return 20 }
    input.y = luma[:1]; input.u = cb[1:2]
    if ApplyFilmGrain(input, p, scratch[:]).code != InvalidInput { return 21 }
    input.u = cb[:1]
    if ApplyFilmGrain(input, p, scratch[:]).code != DecodeOK { return 22 }
    return 0
}
