#import, file "../src/filter/deblock.zi";

DeblockBoundaries :: () -> s32 {
    source: [17]u16
    for i: 0..16 { source[i] = 128 }
    if FilterDeblockEdge(source[:15], 4, 32, 16, 1, 8).error.code != InvalidInput { return 1 }
    if FilterDeblockEdge(source[:], 4, 32, 16, 1, 8).error.code != InvalidInput { return 2 }
    if FilterDeblockEdge(source[:16], 16, 32, 16, 1, 8).error.code != InvalidInput { return 3 }
    if FilterDeblockEdge(source[:16], 4, -1, 16, 1, 8).error.code != InvalidInput { return 4 }
    if FilterDeblockEdge(source[:16], 4, 256, 16, 1, 8).error.code != InvalidInput { return 5 }
    if FilterDeblockEdge(source[:16], 4, 32, -1, 1, 8).error.code != InvalidInput { return 6 }
    if FilterDeblockEdge(source[:16], 4, 32, 256, 1, 8).error.code != InvalidInput { return 7 }
    if FilterDeblockEdge(source[:16], 4, 32, 16, -1, 8).error.code != InvalidInput { return 8 }
    if FilterDeblockEdge(source[:16], 4, 32, 16, 256, 8).error.code != InvalidInput { return 9 }
    if FilterDeblockEdge(source[:16], 4, 32, 16, 1, 9).error.code != InvalidInput { return 10 }
    source[15] = 256
    bad := FilterDeblockEdge(source[:16], 14, 32, 16, 1, 8)
    if bad.error.code != InvalidInput || bad.filter_enabled || bad.high_variance || bad.flat || bad.wide { return 11 }
    for i: 0..15 { if bad.samples[i] != 0 { return 12 } }
    source[15] = 128
    token: Cancellation; Cancel(*token)
    cancelled := FilterDeblockEdge(source[:16], 14, 32, 16, 1, 8, *token)
    if cancelled.error.code != DecodeCancelled || cancelled.filter_enabled || cancelled.high_variance || cancelled.flat || cancelled.wide { return 13 }
    for i: 0..15 { if cancelled.samples[i] != 0 { return 14 } }
    return 0
}

// Filters lines (four lines of p7..q7, line-major) across a horizontal and a
// vertical edge inside 16x20 blocks of sentinels and checks both against
// expected, with every sentinel left unchanged.
DeblockLinesCase :: (lines: []u16, expected: []u16, length: s32, block_limit: s32, limit: s32,
    threshold: s32, depth: s32) -> s32 {
    if lines.count != 64 || expected.count != 64 { return 1 }
    horizontal: [320]u16; vertical: [320]u16
    for i: 0..319 { horizontal[i] = 65535; vertical[i] = 65535 }
    for lane: 0..3 { for k: 0..15 {
        horizontal[k * 20 + lane + 3] = lines[lane * 16 + k]
        vertical[(lane + 3) * 20 + k] = lines[lane * 16 + k]
    } }
    // A horizontal edge filters adjacent columns, a vertical edge adjacent rows.
    if FilterDeblockLines(horizontal[:], 8 * 20 + 3, 1, 20, length, block_limit, limit, threshold, depth).code != DecodeOK { return 2 }
    if FilterDeblockLines(vertical[:], 3 * 20 + 8, 20, 1, length, block_limit, limit, threshold, depth).code != DecodeOK { return 3 }
    for lane: 0..3 { for k: 0..15 {
        value := expected[lane * 16 + k]
        if horizontal[k * 20 + lane + 3] != value || vertical[(lane + 3) * 20 + k] != value { return 4 }
    } }
    for y: 0..15 { for x: 0..19 {
        if (x < 3 || x >= 7) && horizontal[y * 20 + x] != 65535 { return 5 }
        if (y < 3 || y >= 7 || x >= 16) && vertical[y * 20 + x] != 65535 { return 6 }
    } }
    return 0
}

DeblockLinesBoundaries :: () -> s32 {
    block: [320]u16
    for i: 0..319 { block[i] = 128 }
    at: s64 = 8 * 20 + 3
    if FilterDeblockLines(block[:], at, 1, 20, 4, 32, 16, 1, 8).code != DecodeOK { return 1 }
    if FilterDeblockLines(block[:], at, 1, 20, 5, 32, 16, 1, 8).code != InvalidInput { return 2 }
    if FilterDeblockLines(block[:], at, 1, 20, 4, -1, 16, 1, 8).code != InvalidInput { return 3 }
    if FilterDeblockLines(block[:], at, 1, 20, 4, 256, 16, 1, 8).code != InvalidInput { return 4 }
    if FilterDeblockLines(block[:], at, 1, 20, 4, 32, -1, 1, 8).code != InvalidInput { return 5 }
    if FilterDeblockLines(block[:], at, 1, 20, 4, 32, 256, 1, 8).code != InvalidInput { return 6 }
    if FilterDeblockLines(block[:], at, 1, 20, 4, 32, 16, -1, 8).code != InvalidInput { return 7 }
    if FilterDeblockLines(block[:], at, 1, 20, 4, 32, 16, 256, 8).code != InvalidInput { return 8 }
    if FilterDeblockLines(block[:], at, 1, 20, 4, 32, 16, 1, 9).code != InvalidInput { return 9 }
    if FilterDeblockLines(block[:], at, 0, 20, 4, 32, 16, 1, 8).code != InvalidInput { return 10 }
    if FilterDeblockLines(block[:], at, 1, 0, 4, 32, 16, 1, 8).code != InvalidInput { return 11 }
    // Taps before the first sample or after the last.
    if FilterDeblockLines(block[:], 6 * 20 + 3, 1, 20, 14, 32, 16, 1, 8).code != InvalidInput { return 12 }
    if FilterDeblockLines(block[:], 7 * 20 + 3, 1, 20, 14, 32, 16, 1, 8).code != DecodeOK { return 13 }
    if FilterDeblockLines(block[:], 13 * 20 + 8, 20, 1, 4, 32, 16, 1, 8).code != InvalidInput { return 14 }
    if FilterDeblockLines(block[:], 12 * 20 + 8, 20, 1, 4, 32, 16, 1, 8).code != DecodeOK { return 15 }
    // A sample above the depth rejects the segment and writes nothing.
    for i: 0..319 { block[i] = cast(u16)(100 + (i % 7) * 9) }
    block[9 * 20 + 4] = 256
    copy := block
    if FilterDeblockLines(block[:], at, 1, 20, 4, 255, 255, 0, 8).code != InvalidInput { return 16 }
    for i: 0..319 { if block[i] != copy[i] { return 17 } }
    return 0
}
