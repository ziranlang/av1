// AV1 7.13.3 inverse transforms of 8-bit blocks on 16-bit lanes, as libaom
// and dav1d run them: each s16x8 vector holds one value of eight rows or
// columns, the 1D kernels are written out step by step for each length, and
// the block stays in 16 bits between the passes. With 8-bit content the
// row range (BitDepth + 8) and the column range are both 16 bits, so every
// Hadamard clamp is a saturating add and every Round2 of the passes is an
// exact MulHighRound. Only rotation and identity results can leave 16
// bits; the kernels record the largest and smallest of them, and a block
// in which one reaches either 16-bit bound returns false with nothing
// written, so the caller then takes the general transform. Results are
// bit-identical to InverseTransform2D and AddResidual in
// inverse_transform.zi, on every target std/simd supports.
Simd :: #import "std/simd"

// One pass over eight rows or columns: v[k] holds value k of each, one per
// lane. high and low collect the largest and smallest rotation, identity
// and input values.
KernelLanes :: struct { v: [64]s16x8; high: s16x8; low: s16x8; }

// Eight vectors, for transposes.
KernelOctet :: struct { v: [8]s16x8; }

// The block between the passes, row-major at its full width; the caller
// keeps it so no block clears it.
TransformKernelScratch :: struct { block: [4096]s16; }

// Lane pairs (first, second) for MulAddPairs.
KernelPair :: (first: s32, second: s32) -> s16x8 #inline {
    return Simd.Reinterpret(s16x8, Simd.Splat(s32x4, (first & 65535) | (second * 65536)))
}

// Round2 by 12 of two s32x4 halves, packed to 16 bits with saturation.
KernelRound12 :: (low: s32x4, high: s32x4) -> s16x8 #inline {
    round := Simd.Splat(s32x4, 2048)
    return Simd.Narrow(s16x8, Simd.ShiftRight(Simd.Add(low, round), 12), Simd.ShiftRight(Simd.Add(high, round), 12))
}

KernelTrack :: (t: *KernelLanes, v: s16x8) #inline {
    t.high = Simd.Max(t.high, v); t.low = Simd.Min(t.low, v)
}

// B(a, b, angle, flip) of 7.13.2.1 with c = cos128(angle), s = sin128(angle).
KernelRotate :: (t: *KernelLanes, a: s64, b: s64, c: s32, s: s32, flip: bool) #inline {
    p := t.v[a & 63]; q := t.v[b & 63]
    low := Simd.InterleaveLow(p, q); high := Simd.InterleaveHigh(p, q)
    cs := KernelPair(c, -s); sc := KernelPair(s, c)
    x := KernelRound12(Simd.MulAddPairs(low, cs), Simd.MulAddPairs(high, cs))
    y := KernelRound12(Simd.MulAddPairs(low, sc), Simd.MulAddPairs(high, sc))
    t.high = Simd.Max(t.high, Simd.Max(x, y)); t.low = Simd.Min(t.low, Simd.Min(x, y))
    if flip { t.v[a & 63] = y; t.v[b & 63] = x } else { t.v[a & 63] = x; t.v[b & 63] = y }
}

// H(a, b, flip) of 7.13.2.1 at a 16-bit range.
KernelSum :: (t: *KernelLanes, a: s64, b: s64, flip: bool) #inline {
    first := ifx flip then b else a; second := ifx flip then a else b
    x := t.v[first & 63]; y := t.v[second & 63]
    t.v[first & 63] = Simd.AddSat(x, y); t.v[second & 63] = Simd.SubSat(x, y)
}

KernelSwap :: (t: *KernelLanes, a: s64, b: s64) #inline {
    x := t.v[a & 63]; t.v[a & 63] = t.v[b & 63]; t.v[b & 63] = x
}

// The inverse DCTs of 7.13.2.3, the bit-reversal permutation as swaps.
KernelDct4 :: (t: *KernelLanes) #inline {
    KernelSwap(t, 1, 2)
    KernelRotate(t, 0, 1, 2896, 2896, true); KernelRotate(t, 2, 3, 1567, 3784, false)
    KernelSum(t, 0, 3, false); KernelSum(t, 1, 2, false)
}

KernelDct8 :: (t: *KernelLanes) #inline {
    KernelSwap(t, 1, 4); KernelSwap(t, 3, 6)
    KernelRotate(t, 4, 7, 799, 4017, false); KernelRotate(t, 5, 6, 3406, 2276, false)
    KernelRotate(t, 0, 1, 2896, 2896, true); KernelRotate(t, 2, 3, 1567, 3784, false)
    KernelSum(t, 4, 5, false); KernelSum(t, 6, 7, true)
    KernelSum(t, 0, 3, false); KernelSum(t, 1, 2, false)
    KernelRotate(t, 6, 5, 2896, 2896, true)
    KernelSum(t, 0, 7, false); KernelSum(t, 1, 6, false); KernelSum(t, 2, 5, false)
    KernelSum(t, 3, 4, false)
}

KernelDct16 :: (t: *KernelLanes) #inline {
    KernelSwap(t, 1, 8); KernelSwap(t, 2, 4); KernelSwap(t, 3, 12); KernelSwap(t, 5, 10); KernelSwap(t, 7, 14); KernelSwap(t, 11, 13)
    KernelRotate(t, 8, 15, 401, 4076, false); KernelRotate(t, 9, 14, 3166, 2598, false); KernelRotate(t, 10, 13, 1931, 3612, false)
    KernelRotate(t, 11, 12, 3920, 1189, false)
    KernelRotate(t, 4, 7, 799, 4017, false); KernelRotate(t, 5, 6, 3406, 2276, false)
    KernelSum(t, 8, 9, false); KernelSum(t, 10, 11, true); KernelSum(t, 12, 13, false)
    KernelSum(t, 14, 15, true)
    KernelRotate(t, 0, 1, 2896, 2896, true); KernelRotate(t, 2, 3, 1567, 3784, false)
    KernelSum(t, 4, 5, false); KernelSum(t, 6, 7, true)
    KernelRotate(t, 14, 9, 1567, 3784, true); KernelRotate(t, 13, 10, -3784, 1567, true)
    KernelSum(t, 0, 3, false); KernelSum(t, 1, 2, false)
    KernelRotate(t, 6, 5, 2896, 2896, true)
    KernelSum(t, 8, 11, false); KernelSum(t, 9, 10, false); KernelSum(t, 12, 15, true)
    KernelSum(t, 13, 14, true)
    KernelSum(t, 0, 7, false); KernelSum(t, 1, 6, false); KernelSum(t, 2, 5, false)
    KernelSum(t, 3, 4, false)
    KernelRotate(t, 13, 10, 2896, 2896, true); KernelRotate(t, 12, 11, 2896, 2896, true)
    KernelSum(t, 0, 15, false); KernelSum(t, 1, 14, false); KernelSum(t, 2, 13, false)
    KernelSum(t, 3, 12, false); KernelSum(t, 4, 11, false); KernelSum(t, 5, 10, false)
    KernelSum(t, 6, 9, false); KernelSum(t, 7, 8, false)
}

