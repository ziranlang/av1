KernelAdst8 :: (t: *KernelLanes) #inline {
    x0 := t.v[7]; x1 := t.v[0]; x2 := t.v[5]; x3 := t.v[2]; x4 := t.v[3]; x5 := t.v[4]; x6 := t.v[1]; x7 := t.v[6]
    t.v[0] = x0; t.v[1] = x1; t.v[2] = x2; t.v[3] = x3; t.v[4] = x4; t.v[5] = x5; t.v[6] = x6; t.v[7] = x7
    KernelRotate(t, 0, 1, 401, 4076, true); KernelRotate(t, 2, 3, 1931, 3612, true); KernelRotate(t, 4, 5, 3166, 2598, true)
    KernelRotate(t, 6, 7, 3920, 1189, true)
    KernelSum(t, 0, 4, false); KernelSum(t, 1, 5, false); KernelSum(t, 2, 6, false)
    KernelSum(t, 3, 7, false)
    KernelRotate(t, 4, 5, 1567, 3784, true); KernelRotate(t, 7, 6, 3784, 1567, true)
    KernelSum(t, 0, 2, false); KernelSum(t, 4, 6, false); KernelSum(t, 1, 3, false)
    KernelSum(t, 5, 7, false)
    KernelRotate(t, 2, 3, 2896, 2896, true); KernelRotate(t, 6, 7, 2896, 2896, true)
    y0 := t.v[0]; y1 := t.v[4]; y2 := t.v[6]; y3 := t.v[2]; y4 := t.v[3]; y5 := t.v[7]; y6 := t.v[5]; y7 := t.v[1]
    zero := Simd.Zero(s16x8)
    t.v[0] = y0; t.v[1] = Simd.SubSat(zero, y1); t.v[2] = y2; t.v[3] = Simd.SubSat(zero, y3)
    t.v[4] = y4; t.v[5] = Simd.SubSat(zero, y5); t.v[6] = y6; t.v[7] = Simd.SubSat(zero, y7)
}

KernelAdst16 :: (t: *KernelLanes) #inline {
    x0 := t.v[15]; x1 := t.v[0]; x2 := t.v[13]; x3 := t.v[2]; x4 := t.v[11]; x5 := t.v[4]; x6 := t.v[9]; x7 := t.v[6]
    x8 := t.v[7]; x9 := t.v[8]; x10 := t.v[5]; x11 := t.v[10]; x12 := t.v[3]; x13 := t.v[12]; x14 := t.v[1]; x15 := t.v[14]
    t.v[0] = x0; t.v[1] = x1; t.v[2] = x2; t.v[3] = x3; t.v[4] = x4; t.v[5] = x5; t.v[6] = x6; t.v[7] = x7
    t.v[8] = x8; t.v[9] = x9; t.v[10] = x10; t.v[11] = x11; t.v[12] = x12; t.v[13] = x13; t.v[14] = x14; t.v[15] = x15
    KernelRotate(t, 0, 1, 201, 4091, true); KernelRotate(t, 2, 3, 995, 3973, true); KernelRotate(t, 4, 5, 1751, 3703, true)
    KernelRotate(t, 6, 7, 2440, 3290, true); KernelRotate(t, 8, 9, 3035, 2751, true); KernelRotate(t, 10, 11, 3513, 2106, true)
    KernelRotate(t, 12, 13, 3857, 1380, true); KernelRotate(t, 14, 15, 4052, 601, true)
    KernelSum(t, 0, 8, false); KernelSum(t, 1, 9, false); KernelSum(t, 2, 10, false)
    KernelSum(t, 3, 11, false); KernelSum(t, 4, 12, false); KernelSum(t, 5, 13, false)
    KernelSum(t, 6, 14, false); KernelSum(t, 7, 15, false)
    KernelRotate(t, 8, 9, 799, 4017, true); KernelRotate(t, 13, 12, 4017, 799, true); KernelRotate(t, 10, 11, 3406, 2276, true)
    KernelRotate(t, 15, 14, 2276, 3406, true)
    KernelSum(t, 0, 4, false); KernelSum(t, 8, 12, false); KernelSum(t, 1, 5, false)
    KernelSum(t, 9, 13, false); KernelSum(t, 2, 6, false); KernelSum(t, 10, 14, false)
    KernelSum(t, 3, 7, false); KernelSum(t, 11, 15, false)
    KernelRotate(t, 4, 5, 1567, 3784, true); KernelRotate(t, 12, 13, 1567, 3784, true); KernelRotate(t, 7, 6, 3784, 1567, true)
    KernelRotate(t, 15, 14, 3784, 1567, true)
    KernelSum(t, 0, 2, false); KernelSum(t, 4, 6, false); KernelSum(t, 8, 10, false)
    KernelSum(t, 12, 14, false); KernelSum(t, 1, 3, false); KernelSum(t, 5, 7, false)
    KernelSum(t, 9, 11, false); KernelSum(t, 13, 15, false)
    KernelRotate(t, 2, 3, 2896, 2896, true); KernelRotate(t, 6, 7, 2896, 2896, true); KernelRotate(t, 10, 11, 2896, 2896, true)
    KernelRotate(t, 14, 15, 2896, 2896, true)
    y0 := t.v[0]; y1 := t.v[8]; y2 := t.v[12]; y3 := t.v[4]; y4 := t.v[6]; y5 := t.v[14]; y6 := t.v[10]; y7 := t.v[2]
    y8 := t.v[3]; y9 := t.v[11]; y10 := t.v[15]; y11 := t.v[7]; y12 := t.v[5]; y13 := t.v[13]; y14 := t.v[9]; y15 := t.v[1]
    zero := Simd.Zero(s16x8)
    t.v[0] = y0; t.v[1] = Simd.SubSat(zero, y1); t.v[2] = y2; t.v[3] = Simd.SubSat(zero, y3)
    t.v[4] = y4; t.v[5] = Simd.SubSat(zero, y5); t.v[6] = y6; t.v[7] = Simd.SubSat(zero, y7)
    t.v[8] = y8; t.v[9] = Simd.SubSat(zero, y9); t.v[10] = y10; t.v[11] = Simd.SubSat(zero, y11)
    t.v[12] = y12; t.v[13] = Simd.SubSat(zero, y13); t.v[14] = y14; t.v[15] = Simd.SubSat(zero, y15)
}
// One output of the inverse ADST4 of 7.13.2.6, k0*x0 + k1*x1 + k2*x2 +
// k3*x3 rounded by 12 bits, from lanes (x0, x1) in a, b and (x2, x3) in
// c, d. Every sum fits 32 bits.
KernelAdst4Output :: (t: *KernelLanes, a: s16x8, b: s16x8, c: s16x8, d: s16x8, k0: s32, k1: s32, k2: s32,
    k3: s32) -> s16x8 #inline {
    first := KernelPair(k0, k1); second := KernelPair(k2, k3)
    v := KernelRound12(Simd.Add(Simd.MulAddPairs(a, first), Simd.MulAddPairs(c, second)),
        Simd.Add(Simd.MulAddPairs(b, first), Simd.MulAddPairs(d, second)))
    KernelTrack(t, v)
    return v
}

KernelAdst4 :: (t: *KernelLanes) #inline {
    a := Simd.InterleaveLow(t.v[0], t.v[1]); b := Simd.InterleaveHigh(t.v[0], t.v[1])
    c := Simd.InterleaveLow(t.v[2], t.v[3]); d := Simd.InterleaveHigh(t.v[2], t.v[3])
    t.v[0] = KernelAdst4Output(t, a, b, c, d, 1321, 3344, 3803, 2482)
    t.v[1] = KernelAdst4Output(t, a, b, c, d, 2482, 3344, -1321, -3803)
    t.v[2] = KernelAdst4Output(t, a, b, c, d, 3344, 0, -3344, 3344)
    t.v[3] = KernelAdst4Output(t, a, b, c, d, 3803, -3344, 2482, -1321)
}

// The identity transforms of 7.13.2.15: x * 5793 / 4096 is x plus
// MulHighRound by 1697 * 8, and x * 11586 / 4096 is 2x plus MulHighRound
// by 3394 * 8. A result that saturates is out of range and recorded.
KernelIdentity :: (t: *KernelLanes, n: s64) #inline {
    for i: 0..n - 1 {
        x := t.v[i & 63]
        v := x
        if n == 4 { v = Simd.AddSat(x, Simd.MulHighRound(x, Simd.Splat(s16x8, 13576))) }
        else if n == 8 { v = Simd.AddSat(x, x) }
        else if n == 16 { v = Simd.AddSat(Simd.AddSat(x, x), Simd.MulHighRound(x, Simd.Splat(s16x8, 27152))) }
        else { v = Simd.AddSat(x, x); v = Simd.AddSat(v, v) }
        KernelTrack(t, v)
        t.v[i & 63] = v
    }
}

// The 1D transform of kind (0 DCT, 1 ADST, 2 identity) and length n.
KernelInverse1D :: (t: *KernelLanes, kind: s32, n: s64) #inline {
    if kind == 2 { KernelIdentity(t, n); return }
    if n == 4 { if kind == 0 { KernelDct4(t) } else { KernelAdst4(t) } }
    else if n == 8 { if kind == 0 { KernelDct8(t) } else { KernelAdst8(t) } }
    else if n == 16 { if kind == 0 { KernelDct16(t) } else { KernelAdst16(t) } }
    else if n == 32 { KernelDct32(t) }
    else { KernelDct64(t) }
}

// Transposes eight vectors of eight lanes.
KernelTranspose :: (r0: s16x8, r1: s16x8, r2: s16x8, r3: s16x8, r4: s16x8, r5: s16x8, r6: s16x8, r7: s16x8,
    out: *KernelOctet) #inline {
    a0 := Simd.Reinterpret(s32x4, Simd.InterleaveLow(r0, r1)); a1 := Simd.Reinterpret(s32x4, Simd.InterleaveHigh(r0, r1))
    a2 := Simd.Reinterpret(s32x4, Simd.InterleaveLow(r2, r3)); a3 := Simd.Reinterpret(s32x4, Simd.InterleaveHigh(r2, r3))
    a4 := Simd.Reinterpret(s32x4, Simd.InterleaveLow(r4, r5)); a5 := Simd.Reinterpret(s32x4, Simd.InterleaveHigh(r4, r5))
    a6 := Simd.Reinterpret(s32x4, Simd.InterleaveLow(r6, r7)); a7 := Simd.Reinterpret(s32x4, Simd.InterleaveHigh(r6, r7))
    b0 := Simd.Reinterpret(s64x2, Simd.InterleaveLow(a0, a2)); b1 := Simd.Reinterpret(s64x2, Simd.InterleaveHigh(a0, a2))
    b2 := Simd.Reinterpret(s64x2, Simd.InterleaveLow(a1, a3)); b3 := Simd.Reinterpret(s64x2, Simd.InterleaveHigh(a1, a3))
    b4 := Simd.Reinterpret(s64x2, Simd.InterleaveLow(a4, a6)); b5 := Simd.Reinterpret(s64x2, Simd.InterleaveHigh(a4, a6))
    b6 := Simd.Reinterpret(s64x2, Simd.InterleaveLow(a5, a7)); b7 := Simd.Reinterpret(s64x2, Simd.InterleaveHigh(a5, a7))
    out.v[0] = Simd.Reinterpret(s16x8, Simd.InterleaveLow(b0, b4)); out.v[1] = Simd.Reinterpret(s16x8, Simd.InterleaveHigh(b0, b4))
    out.v[2] = Simd.Reinterpret(s16x8, Simd.InterleaveLow(b1, b5)); out.v[3] = Simd.Reinterpret(s16x8, Simd.InterleaveHigh(b1, b5))
    out.v[4] = Simd.Reinterpret(s16x8, Simd.InterleaveLow(b2, b6)); out.v[5] = Simd.Reinterpret(s16x8, Simd.InterleaveHigh(b2, b6))
    out.v[6] = Simd.Reinterpret(s16x8, Simd.InterleaveLow(b3, b7)); out.v[7] = Simd.Reinterpret(s16x8, Simd.InterleaveHigh(b3, b7))
}

// Row `row` of the coefficients from column `at`, eight values packed to
// 16 bits: zero past the box's rows, and its upper half zero when only
// four columns remain in the box.
KernelLoadRow :: (t: *KernelLanes, coefficients: []s32, w: s64, row: s64, at: s64, rows: s64,
    columns: s64) -> s16x8 #inline {
    if row >= rows { return Simd.Zero(s16x8) }
    first := Simd.Load(s32x4, coefficients, row * w + at)
    second := ifx at + 4 < columns then Simd.Load(s32x4, coefficients, row * w + at + 4) else Simd.Zero(s32x4)
    v := Simd.Narrow(s16x8, first, second)
    KernelTrack(t, v)
    return v
}

// The row pass of a w-wide, h-high block: the box's rows eight at a time,
// each group transposed into the lanes, transformed, rounded by the row
// shift and transposed back into block. Rows past the box are never
// written; the column pass knows they are zero.
KernelRowsBody :: (t: *KernelLanes, coefficients: []s32, block: []s16, w: s64, h: s64, kind: s32, rect: bool,
    shift: u32, rows: s64, columns: s64) -> bool #inline {
    zero := Simd.Zero(s16x8)
    t.high = Simd.Splat(s16x8, -32768); t.low = Simd.Splat(s16x8, 32767)
    scale := Simd.Splat(s16x8, 23168); multiplier := Simd.Splat(s16x8, cast(s16)(ifx shift > 0 then 32768 >> shift else 16384))
    octet: KernelOctet
    i0: s64 = 0
    while i0 < rows {
        j0: s64 = 0
        while j0 < columns {
            KernelTranspose(KernelLoadRow(t, coefficients, w, i0, j0, rows, columns),
                KernelLoadRow(t, coefficients, w, i0 + 1, j0, rows, columns),
                KernelLoadRow(t, coefficients, w, i0 + 2, j0, rows, columns),
                KernelLoadRow(t, coefficients, w, i0 + 3, j0, rows, columns),
                KernelLoadRow(t, coefficients, w, i0 + 4, j0, rows, columns),
                KernelLoadRow(t, coefficients, w, i0 + 5, j0, rows, columns),
                KernelLoadRow(t, coefficients, w, i0 + 6, j0, rows, columns),
                KernelLoadRow(t, coefficients, w, i0 + 7, j0, rows, columns), *octet)
            for k: 0..7 { t.v[(j0 + k) & 63] = ifx rect then Simd.MulHighRound(octet.v[k], scale) else octet.v[k] }
            j0 += 8
        }
        for j: j0..w - 1 { t.v[j & 63] = zero }
        KernelInverse1D(t, kind, w)
        if shift > 0 { for j: 0..w - 1 { t.v[j & 63] = Simd.MulHighRound(t.v[j & 63], multiplier) } }
        j0 = 0
        while j0 < w {
            KernelTranspose(t.v[j0 & 63], t.v[(j0 + 1) & 63], t.v[(j0 + 2) & 63], t.v[(j0 + 3) & 63],
                t.v[(j0 + 4) & 63], t.v[(j0 + 5) & 63], t.v[(j0 + 6) & 63], t.v[(j0 + 7) & 63], *octet)
            for k: 0..7 {
                if i0 + k < h {
                    if w == 4 { Simd.StoreLow(block, (i0 + k) * 4, octet.v[k]) }
                    else { Simd.Store(block, (i0 + k) * w + j0, octet.v[k]) }
                }
            }
            j0 += 8
        }
        i0 += 8
    }
    return Simd.ReduceMax(t.high) < 32767 && Simd.ReduceMin(t.low) > -32768
}

// The column pass in place in block, eight columns at a time (four for a
// 4-wide block), rows from `rows` rounded up to 8 on being zero, then
// Round2 by 4.
KernelColumnsBody :: (t: *KernelLanes, block: []s16, w: s64, h: s64, kind: s32, rows: s64) -> bool #inline {
    zero := Simd.Zero(s16x8); sixteenth := Simd.Splat(s16x8, 2048)
    t.high = Simd.Splat(s16x8, -32768); t.low = Simd.Splat(s16x8, 32767)
    filled := (rows + 7) & -8
    if filled > h { filled = h }
    j0: s64 = 0
    while j0 < w {
        for i: 0..filled - 1 {
            t.v[i & 63] = ifx w == 4 then Simd.LoadLow(s16x8, block, i * 4) else Simd.Load(s16x8, block, i * w + j0)
        }
        for i: filled..h - 1 { t.v[i & 63] = zero }
        KernelInverse1D(t, kind, h)
        for i: 0..h - 1 {
            v := Simd.MulHighRound(t.v[i & 63], sixteenth)
            if w == 4 { Simd.StoreLow(block, i * 4, v) } else { Simd.Store(block, i * w + j0, v) }
        }
        j0 += 8
    }
    return Simd.ReduceMax(t.high) < 32767 && Simd.ReduceMin(t.low) > -32768
}

KernelRows4 :: (coefficients: []s32, block: []s16, h: s64, kind: s32, rect: bool, shift: u32, rows: s64,
    columns: s64) -> bool #target {
    t: KernelLanes
    return KernelRowsBody(*t, coefficients, block, 4, h, kind, rect, shift, rows, columns)
}
KernelRows8 :: (coefficients: []s32, block: []s16, h: s64, kind: s32, rect: bool, shift: u32, rows: s64,
    columns: s64) -> bool #target {
    t: KernelLanes
    return KernelRowsBody(*t, coefficients, block, 8, h, kind, rect, shift, rows, columns)
}
KernelRows16 :: (coefficients: []s32, block: []s16, h: s64, kind: s32, rect: bool, shift: u32, rows: s64,
    columns: s64) -> bool #target {
    t: KernelLanes
    return KernelRowsBody(*t, coefficients, block, 16, h, kind, rect, shift, rows, columns)
}
KernelRows32 :: (coefficients: []s32, block: []s16, h: s64, kind: s32, rect: bool, shift: u32, rows: s64,
    columns: s64) -> bool #target {
    t: KernelLanes
    return KernelRowsBody(*t, coefficients, block, 32, h, kind, rect, shift, rows, columns)
}
KernelRows64 :: (coefficients: []s32, block: []s16, h: s64, kind: s32, rect: bool, shift: u32, rows: s64,
    columns: s64) -> bool #target {
    t: KernelLanes
    return KernelRowsBody(*t, coefficients, block, 64, h, kind, rect, shift, rows, columns)
}

KernelColumns4 :: (block: []s16, w: s64, kind: s32, rows: s64) -> bool #target {
    t: KernelLanes
    return KernelColumnsBody(*t, block, w, 4, kind, rows)
}
KernelColumns8 :: (block: []s16, w: s64, kind: s32, rows: s64) -> bool #target {
    t: KernelLanes
    return KernelColumnsBody(*t, block, w, 8, kind, rows)
}
KernelColumns16 :: (block: []s16, w: s64, kind: s32, rows: s64) -> bool #target {
    t: KernelLanes
    return KernelColumnsBody(*t, block, w, 16, kind, rows)
}
KernelColumns32 :: (block: []s16, w: s64, kind: s32, rows: s64) -> bool #target {
    t: KernelLanes
    return KernelColumnsBody(*t, block, w, 32, kind, rows)
}
KernelColumns64 :: (block: []s16, w: s64, kind: s32, rows: s64) -> bool #target {
    t: KernelLanes
    return KernelColumnsBody(*t, block, w, 64, kind, rows)
}

// Adds the w x h block to 8-bit samples with Clip1, the block's rows
// reversed when flip_rows and its columns when flip_columns.
KernelAddBody :: (block: []s16, w: s64, h: s64, samples: []u16, stride: s64, flip_rows: bool,
    flip_columns: bool) #inline {
    zero := Simd.Zero(s16x8); top := Simd.Splat(s16x8, 255)
    for i: 0..h - 1 {
        line := (ifx flip_rows then h - 1 - i else i) * stride
        if w == 4 {
            v := Simd.LoadLow(s16x8, block, i * 4)
            if flip_columns { v = Simd.Shuffle(v, 3, 2, 1, 0, 4, 5, 6, 7) }
            pixels := Simd.Reinterpret(s16x8, Simd.LoadLow(u16x8, samples, line))
            Simd.StoreLow(samples, line, Simd.Reinterpret(u16x8, Simd.Min(Simd.Max(Simd.AddSat(pixels, v), zero), top)))
            continue
        }
        j0: s64 = 0
        while j0 < w {
            v := Simd.Load(s16x8, block, i * w + j0)
            at := line + j0
            if flip_columns { v = Simd.Shuffle(v, 7, 6, 5, 4, 3, 2, 1, 0); at = line + w - 8 - j0 }
            pixels := Simd.Reinterpret(s16x8, Simd.Load(u16x8, samples, at))
            Simd.Store(samples, at, Simd.Reinterpret(u16x8, Simd.Min(Simd.Max(Simd.AddSat(pixels, v), zero), top)))
            j0 += 8
        }
    }
}

KernelAddBlock :: (block: []s16, w: s64, h: s64, samples: []u16, stride: s64, flip_rows: bool,
    flip_columns: bool) #target {
    KernelAddBody(block, w, h, samples, stride, flip_rows, flip_columns)
}

// Square 4/8/16 reconstruction uses one target dispatch and one local lane
// buffer for both passes, letting the compiler keep the fixed 4x4 case in registers.
KernelSquareBody :: (coefficients: []s32, samples: []u16, side: s64, stride: s64, tx_type: s32,
    rows: s64, columns: s64, shift: u32, scratch: *TransformKernelScratch) -> bool #inline {
    lane: KernelLanes
    block := scratch.block[:side * side]
    if !KernelRowsBody(*lane, coefficients, block, side, side, KernelRowKinds[tx_type], false, shift, rows, columns) {
        return false
    }
    if !KernelColumnsBody(*lane, block, side, side, KernelColumnKinds[tx_type], rows) { return false }
    flip_rows := tx_type == 4 || tx_type == 6 || tx_type == 8 || tx_type == 14
    flip_columns := tx_type == 5 || tx_type == 6 || tx_type == 7 || tx_type == 15
    KernelAddBody(block, side, side, samples, stride, flip_rows, flip_columns)
    return true
}

KernelSquare4 :: (coefficients: []s32, samples: []u16, stride: s64, tx_type: s32,
    scratch: *TransformKernelScratch) -> bool #target {
    return KernelSquareBody(coefficients, samples, 4, stride, tx_type, 4, 4, 0, scratch)
}
KernelSquare8 :: (coefficients: []s32, samples: []u16, stride: s64, tx_type: s32, rows: s64,
    columns: s64, scratch: *TransformKernelScratch) -> bool #target {
    return KernelSquareBody(coefficients, samples, 8, stride, tx_type, rows, columns, 1, scratch)
}
KernelSquare16 :: (coefficients: []s32, samples: []u16, stride: s64, tx_type: s32, rows: s64,
    columns: s64, scratch: *TransformKernelScratch) -> bool #target {
    return KernelSquareBody(coefficients, samples, 16, stride, tx_type, rows, columns, 2, scratch)
}

// Widens the w x h block into the row-major s32 residual.
KernelWidenBlock :: (block: []s16, w: s64, h: s64, residual: []s32) #target {
    count := w * h
    if w == 4 {
        i: s64 = 0
        while i < count { Simd.Store(residual, i, Simd.WidenLow(Simd.LoadLow(s16x8, block, i))); i += 4 }
        return
    }
    i: s64 = 0
    while i < count {
        v := Simd.Load(s16x8, block, i)
        Simd.Store(residual, i, Simd.WidenLow(v)); Simd.Store(residual, i + 4, Simd.WidenHigh(v))
        i += 8
    }
}

// Per-direction kinds for transform types 0..15 (0 DCT, 1 ADST, 2
// identity), the flips, and Transform_Row_Shift by (log2W - 2) * 5 +
// log2H - 2, as in inverse_transform.zi.
KernelRowKinds :: s32.[0, 0, 1, 1, 0, 1, 1, 1, 1, 2, 2, 0, 2, 1, 2, 1]
KernelColumnKinds :: s32.[0, 1, 0, 1, 1, 0, 1, 1, 1, 2, 0, 2, 1, 2, 1, 2]
KernelRowShifts :: u32.[0, 0, 1, 0, 0, 0, 1, 1, 2, 0, 1, 1, 2, 1, 2, 0, 2, 1, 2, 1, 0, 0, 2, 1, 2]

KernelLog2 :: (side: s32) -> s64 {
    if side == 4 { return 2 }; if side == 8 { return 3 }; if side == 16 { return 4 }
    if side == 32 { return 5 }; if side == 64 { return 6 }
    return -1
}

// Both passes into scratch.block; false when the shape, type or box is not
// one these kernels take, or a value leaves 16 bits.
KernelTransform :: (coefficients: []s32, width: s32, height: s32, tx_type: s32, rows: s64, columns: s64,
    scratch: *TransformKernelScratch) -> bool {
    log2w := KernelLog2(width); log2h := KernelLog2(height)
    if log2w < 0 || log2h < 0 || log2w - log2h > 2 || log2h - log2w > 2 || tx_type < 0 || tx_type > 15 { return false }
    w := cast(s64)width; h := cast(s64)height
    row_kind := KernelRowKinds[tx_type]; column_kind := KernelColumnKinds[tx_type]
    if (row_kind == 1 && w > 16) || (row_kind == 2 && w > 32) || (column_kind == 1 && h > 16) ||
        (column_kind == 2 && h > 32) {
        return false
    }
    if rows < 4 || columns < 4 || rows > h || columns > w || rows > 32 || columns > 32 ||
        (rows & 3) != 0 || (columns & 3) != 0 { return false }
    box_rows := (rows + 3) & -4; box_columns := (columns + 3) & -4
    if coefficients.count < (box_rows - 1) * w + box_columns { return false }
    block := scratch.block[:w * h]
    rect := log2w - log2h == 1 || log2h - log2w == 1
    shift := KernelRowShifts[(log2w - 2) * 5 + log2h - 2]
    ok := false
    if w == 4 { ok = KernelRows4(coefficients, block, h, row_kind, rect, shift, box_rows, box_columns) }
    else if w == 8 { ok = KernelRows8(coefficients, block, h, row_kind, rect, shift, box_rows, box_columns) }
    else if w == 16 { ok = KernelRows16(coefficients, block, h, row_kind, rect, shift, box_rows, box_columns) }
    else if w == 32 { ok = KernelRows32(coefficients, block, h, row_kind, rect, shift, box_rows, box_columns) }
    else { ok = KernelRows64(coefficients, block, h, row_kind, rect, shift, box_rows, box_columns) }
    if !ok { return false }
    if h == 4 { return KernelColumns4(block, w, column_kind, box_rows) }
    if h == 8 { return KernelColumns8(block, w, column_kind, box_rows) }
    if h == 16 { return KernelColumns16(block, w, column_kind, box_rows) }
    if h == 32 { return KernelColumns32(block, w, column_kind, box_rows) }
    return KernelColumns64(block, w, column_kind, box_rows)
}

// AV1 7.12.3's reconstruction of one 8-bit lossy block: the inverse
// transform of the coefficient box, then the type's flips and Clip1 added to
// samples, which must be at most 255. coefficients is row-major at the full
// width; only its upper-left rows x columns box (multiples of 4) is read,
// and it is zero elsewhere. Returns false, with nothing
// written, when the shape, type or box is not one these kernels take or an
// intermediate leaves 16 bits; the caller then takes the general path.
InverseTransformAdd8 :: (coefficients: []s32, width: s32, height: s32, tx_type: s32, rows: s64, columns: s64,
    samples: []u16, stride: s64, scratch: *TransformKernelScratch) -> bool {
    w := cast(s64)width; h := cast(s64)height
    if w < 4 || w > 64 || h < 4 || h > 64 || stride < w || samples.count < w { return false }
    if (samples.count - w) / stride < h - 1 { return false }
    if w == h && (w == 4 || w == 8 || w == 16) {
        if tx_type < 0 || tx_type > 15 || rows < 4 || rows > h || columns < 4 || columns > w ||
            (rows & 3) != 0 || (columns & 3) != 0 { return false }
        if coefficients.count < (rows - 1) * w + columns { return false }
        if w == 4 { return KernelSquare4(coefficients, samples, stride, tx_type, scratch) }
        if w == 8 { return KernelSquare8(coefficients, samples, stride, tx_type, rows, columns, scratch) }
        return KernelSquare16(coefficients, samples, stride, tx_type, rows, columns, scratch)
    }
    if !KernelTransform(coefficients, width, height, tx_type, rows, columns, scratch) { return false }
    flip_rows := tx_type == 4 || tx_type == 6 || tx_type == 8 || tx_type == 14
    flip_columns := tx_type == 5 || tx_type == 6 || tx_type == 7 || tx_type == 15
    KernelAddBlock(scratch.block[:w * h], w, h, samples, stride, flip_rows, flip_columns)
    return true
}

// The unflipped row-major Residual of InverseTransform2D for an 8-bit block,
// read from the coefficient box as InverseTransformAdd8 reads it. residual
// holds width x height values and may alias coefficients. Returns false,
// with nothing written, as InverseTransformAdd8 does.
InverseTransform8 :: (coefficients: []s32, residual: []s32, width: s32, height: s32, tx_type: s32, rows: s64,
    columns: s64, scratch: *TransformKernelScratch) -> bool {
    w := cast(s64)width; h := cast(s64)height
    if w < 4 || w > 64 || h < 4 || h > 64 || residual.count < w * h { return false }
    if !KernelTransform(coefficients, width, height, tx_type, rows, columns, scratch) { return false }
    KernelWidenBlock(scratch.block[:w * h], w, h, residual)
    return true
}
