    HighKernelSum(t, 8, 9, false); HighKernelSum(t, 10, 11, true); HighKernelSum(t, 12, 13, false)
    HighKernelSum(t, 14, 15, true)
    HighKernelRotate(t, 0, 1, 2896, 2896, true); HighKernelRotate(t, 2, 3, 1567, 3784, false)
    HighKernelSum(t, 4, 5, false); HighKernelSum(t, 6, 7, true)
    HighKernelRotate(t, 14, 9, 1567, 3784, true); HighKernelRotate(t, 13, 10, -3784, 1567, true)
    HighKernelSum(t, 0, 3, false); HighKernelSum(t, 1, 2, false)
