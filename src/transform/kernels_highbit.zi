    y0 := t.v[0]; y1 := t.v[4]; y2 := t.v[6]; y3 := t.v[2]; y4 := t.v[3]; y5 := t.v[7]; y6 := t.v[5]; y7 := t.v[1]
    zero := Simd.Zero(s32x4)
    t.v[0] = y0; t.v[1] = Simd.Sub(zero, y1); t.v[2] = y2; t.v[3] = Simd.Sub(zero, y3)
    t.v[4] = y4; t.v[5] = Simd.Sub(zero, y5); t.v[6] = y6; t.v[7] = Simd.Sub(zero, y7)
}

HighKernelAdst16 :: (t: *HighKernelLanes) #inline {
    x0 := t.v[15]; x1 := t.v[0]; x2 := t.v[13]; x3 := t.v[2]; x4 := t.v[11]; x5 := t.v[4]; x6 := t.v[9]; x7 := t.v[6]
    x8 := t.v[7]; x9 := t.v[8]; x10 := t.v[5]; x11 := t.v[10]; x12 := t.v[3]; x13 := t.v[12]; x14 := t.v[1]; x15 := t.v[14]
    t.v[0] = x0; t.v[1] = x1; t.v[2] = x2; t.v[3] = x3; t.v[4] = x4; t.v[5] = x5; t.v[6] = x6; t.v[7] = x7
    t.v[8] = x8; t.v[9] = x9; t.v[10] = x10; t.v[11] = x11; t.v[12] = x12; t.v[13] = x13; t.v[14] = x14; t.v[15] = x15
    HighKernelRotate(t, 0, 1, 201, 4091, true); HighKernelRotate(t, 2, 3, 995, 3973, true); HighKernelRotate(t, 4, 5, 1751, 3703, true)
    HighKernelRotate(t, 6, 7, 2440, 3290, true); HighKernelRotate(t, 8, 9, 3035, 2751, true); HighKernelRotate(t, 10, 11, 3513, 2106, true)
    HighKernelRotate(t, 12, 13, 3857, 1380, true); HighKernelRotate(t, 14, 15, 4052, 601, true)
    HighKernelSum(t, 0, 8, false); HighKernelSum(t, 1, 9, false); HighKernelSum(t, 2, 10, false)
    HighKernelSum(t, 3, 11, false); HighKernelSum(t, 4, 12, false); HighKernelSum(t, 5, 13, false)
    HighKernelSum(t, 6, 14, false); HighKernelSum(t, 7, 15, false)
    HighKernelRotate(t, 8, 9, 799, 4017, true); HighKernelRotate(t, 13, 12, 4017, 799, true); HighKernelRotate(t, 10, 11, 3406, 2276, true)
    HighKernelRotate(t, 15, 14, 2276, 3406, true)
    HighKernelSum(t, 0, 4, false); HighKernelSum(t, 8, 12, false); HighKernelSum(t, 1, 5, false)
    HighKernelSum(t, 9, 13, false); HighKernelSum(t, 2, 6, false); HighKernelSum(t, 10, 14, false)
    HighKernelSum(t, 3, 7, false); HighKernelSum(t, 11, 15, false)
    HighKernelRotate(t, 4, 5, 1567, 3784, true); HighKernelRotate(t, 12, 13, 1567, 3784, true); HighKernelRotate(t, 7, 6, 3784, 1567, true)
    HighKernelRotate(t, 15, 14, 3784, 1567, true)
    HighKernelSum(t, 0, 2, false); HighKernelSum(t, 4, 6, false); HighKernelSum(t, 8, 10, false)
    HighKernelSum(t, 12, 14, false); HighKernelSum(t, 1, 3, false); HighKernelSum(t, 5, 7, false)
    HighKernelSum(t, 9, 11, false); HighKernelSum(t, 13, 15, false)
    HighKernelRotate(t, 2, 3, 2896, 2896, true); HighKernelRotate(t, 6, 7, 2896, 2896, true); HighKernelRotate(t, 10, 11, 2896, 2896, true)
    HighKernelRotate(t, 14, 15, 2896, 2896, true)
    y0 := t.v[0]; y1 := t.v[8]; y2 := t.v[12]; y3 := t.v[4]; y4 := t.v[6]; y5 := t.v[14]; y6 := t.v[10]; y7 := t.v[2]
    y8 := t.v[3]; y9 := t.v[11]; y10 := t.v[15]; y11 := t.v[7]; y12 := t.v[5]; y13 := t.v[13]; y14 := t.v[9]; y15 := t.v[1]
    zero := Simd.Zero(s32x4)
    t.v[0] = y0; t.v[1] = Simd.Sub(zero, y1); t.v[2] = y2; t.v[3] = Simd.Sub(zero, y3)
    t.v[4] = y4; t.v[5] = Simd.Sub(zero, y5); t.v[6] = y6; t.v[7] = Simd.Sub(zero, y7)
    t.v[8] = y8; t.v[9] = Simd.Sub(zero, y9); t.v[10] = y10; t.v[11] = Simd.Sub(zero, y11)
    t.v[12] = y12; t.v[13] = Simd.Sub(zero, y13); t.v[14] = y14; t.v[15] = Simd.Sub(zero, y15)
}
HighKernelAdst4Output :: (t: *HighKernelLanes, x0: s32x4, x1: s32x4, x2: s32x4, x3: s32x4,
    c0: s32, c1: s32, c2: s32, c3: s32) -> s32x4 #inline {
    a := Simd.Add(Simd.Mul(x0, Simd.Splat(s32x4, c0)), Simd.Mul(x1, Simd.Splat(s32x4, c1)))
    b := Simd.Add(Simd.Mul(x2, Simd.Splat(s32x4, c2)), Simd.Mul(x3, Simd.Splat(s32x4, c3)))
    return HighKernelBound(t, HighKernelRound(Simd.Add(a, b), 12))
}
HighKernelAdst4 :: (t: *HighKernelLanes) #inline {
    a := t.v[0]; b := t.v[1]; c := t.v[2]; d := t.v[3]
    t.v[0] = HighKernelAdst4Output(t, a, b, c, d, 1321, 3344, 3803, 2482)
    t.v[1] = HighKernelAdst4Output(t, a, b, c, d, 2482, 3344, -1321, -3803)
    t.v[2] = HighKernelAdst4Output(t, a, b, c, d, 3344, 0, -3344, 3344)
    t.v[3] = HighKernelAdst4Output(t, a, b, c, d, 3803, -3344, 2482, -1321)
}
HighKernelIdentity :: (t: *HighKernelLanes, n: s64) #inline {
    for i: 0..n - 1 {
        x := t.v[i & 63]
        v := x
        if n == 4 { v = HighKernelRound(Simd.Mul(x, Simd.Splat(s32x4, 5793)), 12) }
        else if n == 8 { v = Simd.Add(x, x) }
        else if n == 16 { v = HighKernelRound(Simd.Mul(x, Simd.Splat(s32x4, 11586)), 12) }
        else { v = Simd.ShiftLeft(x, 2) }
        t.v[i & 63] = HighKernelBound(t, v)
    }
}
HighKernelInverse1D :: (t: *HighKernelLanes, kind: s32, n: s64) #inline {
    if kind == 2 { HighKernelIdentity(t, n) }
    else if n == 4 { if kind == 0 { HighKernelDct4(t) } else { HighKernelAdst4(t) } }
    else if n == 8 { if kind == 0 { HighKernelDct8(t) } else { HighKernelAdst8(t) } }
    else if n == 16 { if kind == 0 { HighKernelDct16(t) } else { HighKernelAdst16(t) } }
    else if n == 32 { HighKernelDct32(t) }
    else { HighKernelDct64(t) }
    for i: 0..n - 1 { t.v[i & 63] = HighKernelBound(t, t.v[i & 63]) }
}
HighKernelTranspose :: (r0: s32x4, r1: s32x4, r2: s32x4, r3: s32x4, out: *HighKernelQuad) #inline {
    a := Simd.Reinterpret(s64x2, Simd.InterleaveLow(r0, r1))
    b := Simd.Reinterpret(s64x2, Simd.InterleaveHigh(r0, r1))
    c := Simd.Reinterpret(s64x2, Simd.InterleaveLow(r2, r3))
    d := Simd.Reinterpret(s64x2, Simd.InterleaveHigh(r2, r3))
    out.v[0] = Simd.Reinterpret(s32x4, Simd.InterleaveLow(a, c))
    out.v[1] = Simd.Reinterpret(s32x4, Simd.InterleaveHigh(a, c))
    out.v[2] = Simd.Reinterpret(s32x4, Simd.InterleaveLow(b, d))
    out.v[3] = Simd.Reinterpret(s32x4, Simd.InterleaveHigh(b, d))
}
HighKernelRowsBody :: (coefficients: []s32, block: []s32, w: s64, h: s64, kind: s32, rect: bool,
    shift: u32, rows: s64, columns: s64) -> bool #inline {
    t: HighKernelLanes; quad: HighKernelQuad
    t.high = Simd.Splat(s32x4, -2147483648); t.low = Simd.Splat(s32x4, 2147483647)
    t.ceiling = Simd.Splat(s32x4, 131071); t.floor = Simd.Splat(s32x4, -131072)
    low := Simd.Splat(s32x4, -32768); high := Simd.Splat(s32x4, 32767)
    i0: s64
    while i0 < rows {
        j0: s64
        while j0 < columns {
            HighKernelTranspose(Simd.Load(s32x4, coefficients, i0 * w + j0),
                Simd.Load(s32x4, coefficients, (i0 + 1) * w + j0),
                Simd.Load(s32x4, coefficients, (i0 + 2) * w + j0),
                Simd.Load(s32x4, coefficients, (i0 + 3) * w + j0), *quad)
            for k: 0..3 {
                v := HighKernelBound(*t, quad.v[k])
                if rect { v = HighKernelRound(Simd.Mul(v, Simd.Splat(s32x4, 2896)), 12) }
                t.v[(j0 + k) & 63] = v
            }
            j0 += 4
        }
        for j: columns..w - 1 { t.v[j & 63] = Simd.Zero(s32x4) }
        HighKernelInverse1D(*t, kind, w)
        for j: 0..w - 1 { t.v[j & 63] = Simd.Min(Simd.Max(HighKernelRound(t.v[j & 63], shift), low), high) }
        j0 = 0
        while j0 < w {
            HighKernelTranspose(t.v[j0 & 63], t.v[(j0 + 1) & 63], t.v[(j0 + 2) & 63], t.v[(j0 + 3) & 63], *quad)
            for k: 0..3 { Simd.Store(block, (i0 + k) * w + j0, quad.v[k]) }
            j0 += 4
        }
        i0 += 4
    }
    return Simd.ReduceMax(t.high) <= 131071 && Simd.ReduceMin(t.low) >= -131072
}
HighKernelColumnsBody :: (block: []s32, w: s64, h: s64, kind: s32, rows: s64) -> bool #inline {
    t: HighKernelLanes
    t.high = Simd.Splat(s32x4, -2147483648); t.low = Simd.Splat(s32x4, 2147483647)
    t.ceiling = Simd.Splat(s32x4, 32767); t.floor = Simd.Splat(s32x4, -32768)
    j0: s64
    while j0 < w {
        for i: 0..rows - 1 { t.v[i & 63] = Simd.Load(s32x4, block, i * w + j0) }
        for i: rows..h - 1 { t.v[i & 63] = Simd.Zero(s32x4) }
        HighKernelInverse1D(*t, kind, h)
        for i: 0..h - 1 { Simd.Store(block, i * w + j0, HighKernelRound(t.v[i & 63], 4)) }
        j0 += 4
    }
    return Simd.ReduceMax(t.high) <= 32767 && Simd.ReduceMin(t.low) >= -32768
}
HighKernelRows4 :: (coefficients: []s32, block: []s32, h: s64, kind: s32, rect: bool,
    shift: u32, rows: s64, columns: s64) -> bool #target {
    return HighKernelRowsBody(coefficients, block, 4, h, kind, rect, shift, rows, columns)
}
HighKernelColumns4 :: (block: []s32, w: s64, kind: s32, rows: s64) -> bool #target {
    return HighKernelColumnsBody(block, w, 4, kind, rows)
}

HighKernelRows8 :: (coefficients: []s32, block: []s32, h: s64, kind: s32, rect: bool,
    shift: u32, rows: s64, columns: s64) -> bool #target {
    return HighKernelRowsBody(coefficients, block, 8, h, kind, rect, shift, rows, columns)
}
HighKernelColumns8 :: (block: []s32, w: s64, kind: s32, rows: s64) -> bool #target {
    return HighKernelColumnsBody(block, w, 8, kind, rows)
}

HighKernelRows16 :: (coefficients: []s32, block: []s32, h: s64, kind: s32, rect: bool,
    shift: u32, rows: s64, columns: s64) -> bool #target {
    return HighKernelRowsBody(coefficients, block, 16, h, kind, rect, shift, rows, columns)
}
HighKernelColumns16 :: (block: []s32, w: s64, kind: s32, rows: s64) -> bool #target {
    return HighKernelColumnsBody(block, w, 16, kind, rows)
}

HighKernelRows32 :: (coefficients: []s32, block: []s32, h: s64, kind: s32, rect: bool,
    shift: u32, rows: s64, columns: s64) -> bool #target {
    return HighKernelRowsBody(coefficients, block, 32, h, kind, rect, shift, rows, columns)
}
HighKernelColumns32 :: (block: []s32, w: s64, kind: s32, rows: s64) -> bool #target {
    return HighKernelColumnsBody(block, w, 32, kind, rows)
}

HighKernelRows64 :: (coefficients: []s32, block: []s32, h: s64, kind: s32, rect: bool,
    shift: u32, rows: s64, columns: s64) -> bool #target {
    return HighKernelRowsBody(coefficients, block, 64, h, kind, rect, shift, rows, columns)
}
HighKernelColumns64 :: (block: []s32, w: s64, kind: s32, rows: s64) -> bool #target {
    return HighKernelColumnsBody(block, w, 64, kind, rows)
}
HighKernelRowKinds :: s32.[0, 0, 1, 1, 0, 1, 1, 1, 1, 2, 2, 0, 2, 1, 2, 1]
HighKernelColumnKinds :: s32.[0, 1, 0, 1, 1, 0, 1, 1, 1, 2, 0, 2, 1, 2, 1, 2]
HighKernelRowShifts :: u32.[0, 0, 1, 0, 0, 0, 1, 1, 2, 0, 1, 1, 2, 1, 2, 0, 2, 1, 2, 1, 0, 0, 2, 1, 2]

HighKernelLog2 :: (side: s32) -> s64 {
    if side == 4 { return 2 }; if side == 8 { return 3 }; if side == 16 { return 4 }
    if side == 32 { return 5 }; if side == 64 { return 6 }
    return -1
}

// Computes into caller scratch; coefficients and output remain untouched on rejection.
HighKernelTransform :: (coefficients: []s32, width: s32, height: s32, tx_type: s32, rows: s64,
    columns: s64, scratch: *TransformHighKernelScratch) -> bool {
    log2w := HighKernelLog2(width); log2h := HighKernelLog2(height)
    if log2w < 0 || log2h < 0 || log2w - log2h > 2 || log2h - log2w > 2 || tx_type < 0 || tx_type > 15 { return false }
    w := cast(s64)width; h := cast(s64)height
    rk := HighKernelRowKinds[tx_type]; ck := HighKernelColumnKinds[tx_type]
    if (rk == 1 && w > 16) || (rk == 2 && w > 32) || (ck == 1 && h > 16) || (ck == 2 && h > 32) { return false }
    if rows < 4 || rows > h || rows > 32 || columns < 4 || columns > w || columns > 32 ||
        (rows & 3) != 0 || (columns & 3) != 0 { return false }
    if coefficients.count < (rows - 1) * w + columns { return false }
    block := scratch.block[:w * h]
    rect := log2w - log2h == 1 || log2h - log2w == 1
    shift := HighKernelRowShifts[(log2w - 2) * 5 + log2h - 2]
    ok := false
    if w == 4 { ok = HighKernelRows4(coefficients, block, h, rk, rect, shift, rows, columns) }
    else if w == 8 { ok = HighKernelRows8(coefficients, block, h, rk, rect, shift, rows, columns) }
    else if w == 16 { ok = HighKernelRows16(coefficients, block, h, rk, rect, shift, rows, columns) }
    else if w == 32 { ok = HighKernelRows32(coefficients, block, h, rk, rect, shift, rows, columns) }
    else { ok = HighKernelRows64(coefficients, block, h, rk, rect, shift, rows, columns) }
    if !ok { return false }
    if h == 4 { return HighKernelColumns4(block, w, ck, rows) }
    if h == 8 { return HighKernelColumns8(block, w, ck, rows) }
    if h == 16 { return HighKernelColumns16(block, w, ck, rows) }
    if h == 32 { return HighKernelColumns32(block, w, ck, rows) }
    return HighKernelColumns64(block, w, ck, rows)
}
HighKernelAdd :: (block: []s32, samples: []u16, w: s64, h: s64, stride: s64, tx_type: s32) #target {
    flip_rows := tx_type == 4 || tx_type == 6 || tx_type == 8 || tx_type == 14
    flip_columns := tx_type == 5 || tx_type == 6 || tx_type == 7 || tx_type == 15
    for i: 0..h - 1 {
        line := (ifx flip_rows then h - 1 - i else i) * stride
        j: s64
        while j < w {
            v := Simd.Load(s32x4, block, i * w + j)
            at := line + j
            if flip_columns { v = Simd.Shuffle(v, 3, 2, 1, 0); at = line + w - 4 - j }
            pixels := Simd.Reinterpret(s16x8, Simd.LoadLow(u16x8, samples, at))
            sum := Simd.Add(Simd.WidenLow(pixels), v)
            clipped := Simd.Min(Simd.Max(sum, Simd.Zero(s32x4)), Simd.Splat(s32x4, 1023))
            Simd.StoreLow(samples, at, Simd.Reinterpret(u16x8, Simd.Narrow(s16x8, clipped, Simd.Zero(s32x4))))
            j += 4
        }
    }
}
// Fused 10-bit inverse transform, flips and Clip1. maximum must be 1023;
// samples must be at most maximum. Only the valid rows x columns box is read.
// Returns false before writing samples when the shape, box or range is unsupported.
InverseTransformAdd10 :: (coefficients: []s32, width: s32, height: s32, tx_type: s32, rows: s64,
    columns: s64, samples: []u16, stride: s64, maximum: s64, scratch: *TransformHighKernelScratch) -> bool {
    w := cast(s64)width; h := cast(s64)height
    if w < 4 || w > 64 || h < 4 || h > 64 || maximum != 1023 || stride < w || samples.count < w { return false }
    if (samples.count - w) / stride < h - 1 { return false }
    if !HighKernelTransform(coefficients, width, height, tx_type, rows, columns, scratch) { return false }
    HighKernelAdd(scratch.block[:w * h], samples, w, h, stride, tx_type)
    return true
}
// Unflipped residual, allowing coefficients and residual to share their storage.
InverseTransform10 :: (coefficients: []s32, residual: []s32, width: s32, height: s32, tx_type: s32,
    rows: s64, columns: s64, scratch: *TransformHighKernelScratch) -> bool {
    w := cast(s64)width; h := cast(s64)height
    if w < 4 || w > 64 || h < 4 || h > 64 || residual.count < w * h { return false }
    if !HighKernelTransform(coefficients, width, height, tx_type, rows, columns, scratch) { return false }
    for i: 0..w * h - 1 { residual[i] = scratch.block[i] }
    return true
}
