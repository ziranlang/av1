// AV1 10-bit inverse transforms on four s32 lanes. Row intermediates
// have an 18-bit range, column intermediates a 16-bit range. Rotations
// leaving the current range reject the block before any output is stored;
// clamping those rejected intermediates keeps subsequent products in s32.
Simd :: #import "std/simd"

HighKernelLanes :: struct {
    v: [64]s32x4
    high: s32x4; low: s32x4
    ceiling: s32x4; floor: s32x4
}
HighKernelQuad :: struct { v: [4]s32x4; }
TransformHighKernelScratch :: struct { block: [4096]s32; }

HighKernelRound :: (v: s32x4, shift: u32) -> s32x4 #inline {
    if shift == 0 { return v }
    return Simd.ShiftRight(Simd.Add(v, Simd.Splat(s32x4, cast(s32)(cast(u32)1 << (shift - 1)))), shift)
}
HighKernelBound :: (t: *HighKernelLanes, v: s32x4) -> s32x4 #inline {
    t.high = Simd.Max(t.high, v); t.low = Simd.Min(t.low, v)
    return Simd.Min(Simd.Max(v, t.floor), t.ceiling)
}
HighKernelRotate :: (t: *HighKernelLanes, a: s64, b: s64, c: s32, s: s32, flip: bool) #inline {
    p := t.v[a & 63]; q := t.v[b & 63]
    cv := Simd.Splat(s32x4, c); sv := Simd.Splat(s32x4, s)
    x := HighKernelBound(t, HighKernelRound(Simd.Sub(Simd.Mul(p, cv), Simd.Mul(q, sv)), 12))
    y := HighKernelBound(t, HighKernelRound(Simd.Add(Simd.Mul(p, sv), Simd.Mul(q, cv)), 12))
    if flip { t.v[a & 63] = y; t.v[b & 63] = x } else { t.v[a & 63] = x; t.v[b & 63] = y }
}
HighKernelSum :: (t: *HighKernelLanes, a: s64, b: s64, flip: bool) #inline {
    first := ifx flip then b else a; second := ifx flip then a else b
    x := t.v[first & 63]; y := t.v[second & 63]
    t.v[first & 63] = Simd.Min(Simd.Max(Simd.Add(x, y), t.floor), t.ceiling)
    t.v[second & 63] = Simd.Min(Simd.Max(Simd.Sub(x, y), t.floor), t.ceiling)
}
HighKernelSwap :: (t: *HighKernelLanes, a: s64, b: s64) #inline {
    x := t.v[a & 63]; t.v[a & 63] = t.v[b & 63]; t.v[b & 63] = x
}

HighKernelDct4 :: (t: *HighKernelLanes) #inline {
    HighKernelSwap(t, 1, 2)
    HighKernelRotate(t, 0, 1, 2896, 2896, true); HighKernelRotate(t, 2, 3, 1567, 3784, false)
    HighKernelSum(t, 0, 3, false); HighKernelSum(t, 1, 2, false)
}

HighKernelDct8 :: (t: *HighKernelLanes) #inline {
    HighKernelSwap(t, 1, 4); HighKernelSwap(t, 3, 6)
    HighKernelRotate(t, 4, 7, 799, 4017, false); HighKernelRotate(t, 5, 6, 3406, 2276, false)
    HighKernelRotate(t, 0, 1, 2896, 2896, true); HighKernelRotate(t, 2, 3, 1567, 3784, false)
    HighKernelSum(t, 4, 5, false); HighKernelSum(t, 6, 7, true)
    HighKernelSum(t, 0, 3, false); HighKernelSum(t, 1, 2, false)
    HighKernelRotate(t, 6, 5, 2896, 2896, true)
    HighKernelSum(t, 0, 7, false); HighKernelSum(t, 1, 6, false); HighKernelSum(t, 2, 5, false)
    HighKernelSum(t, 3, 4, false)
}

