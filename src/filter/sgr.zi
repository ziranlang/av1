using Codec :: #import "image_codec/api"

// AV1 7.17.2/3 self-guided restoration scalar semantic reference. No allocation,
// native codec calls or frame scheduling. Caller supplies the resolved 3-pixel
// restoration halo, including pre-CDEF samples outside the restoration stripe.
SgrBlock :: struct { samples: [64]u16; width: s32; height: s32; error: DecodeError; }

// Sgr_Params row set: [r0, e0, r1, e1]; index 0/2 are the pass radii.
SgrParameters :: (set: s32, pass: s32) -> s32 {
    parameters: [64]s32 = .[2,12,1,4,2,15,1,6,2,18,1,8,2,21,1,9,
        2,24,1,10,2,29,1,11,2,36,1,12,2,45,1,13,
        2,56,1,14,2,68,1,15,0,0,1,5,0,0,1,8,
        0,0,1,11,0,0,1,14,2,30,0,0,2,75,0,0]
    return parameters[set * 4 + pass]
}

#scope_file
SgrPass :: struct { samples: [64]s64; error: DecodeError; }
// Floor((value + 2^shift/2) / 2^shift) for any sign: the arithmetic shift
// floors, so this is Round2 for non-negative values and the spec's rounding
// of signed sums.
SgrRound :: (value: s64, shift: s32) -> s64 {
    if shift == 0 { return value }
    return (value + (cast(s64)1 << cast(u32)(shift - 1))) >> cast(u32)shift
}
// A2 of each z, the reciprocal step of AV1 7.17.3: 1 at z 0,
// (z * 256 + z / 2) / (z + 1) below 255 and 256 from 255 on.
SgrXByXPlus1 :: () -> [256]u16 {
    values: [256]u16 = .[
        1,128,171,192,205,213,219,224,228,230,233,235,236,238,239,240,
        241,242,243,243,244,244,245,245,246,246,247,247,247,247,248,248,
        248,248,249,249,249,249,249,250,250,250,250,250,250,250,251,251,
        251,251,251,251,251,251,251,251,252,252,252,252,252,252,252,252,
        252,252,252,252,252,252,252,252,252,253,253,253,253,253,253,253,
        253,253,253,253,253,253,253,253,253,253,253,253,253,253,253,253,
        253,253,253,253,253,253,254,254,254,254,254,254,254,254,254,254,
        254,254,254,254,254,254,254,254,254,254,254,254,254,254,254,254,
        254,254,254,254,254,254,254,254,254,254,254,254,254,254,254,254,
        254,254,254,254,254,254,254,254,254,254,254,254,254,254,254,254,
        254,254,254,254,254,254,254,254,254,254,255,255,255,255,255,255,
        255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,
        255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,
        255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,
        255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,
        255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,256
    ]
    return values
}
SgrBox :: (input: []u16, stride: s32, width: s32, height: s32,
    set: s32, pass: s32, bit_depth: s32, x_by_xplus1: []u16, cancellation: *Cancellation) -> SgrPass {
    result: SgrPass
    radius := SgrParameters(set, pass * 2)
    if radius == 0 { return result }
    epsilon := cast(s64)SgrParameters(set, pass * 2 + 1)
    n := cast(s64)((2 * radius + 1) * (2 * radius + 1))
    n2e := n * n * epsilon
    scale: s64 = (1048576 + n2e / 2) / n2e
    reciprocal: s64 = (4096 + n / 2) / n
    a_values: [100]s64; b_values: [100]s64
    // Window sums from per-column sums: column j covers input column
    // j + 2 - radius over the 2*radius+1 rows centred on row iy + 2.
    column_sums: [16]s64; column_squares: [16]s64
    columns := width + 2 + 2 * radius
    for iy: 0..height + 1 {
        result.error = CancellationError(cancellation)
        if result.error.code != DecodeOK { return result }
        // The radius-2 pass is combined from even rows of A and B only.
        if radius == 2 && pass == 0 && (iy & 1) != 0 { continue }
        top := (cast(s32)iy + 2 - radius) * stride + 2 - radius
        for j: 0..columns - 1 {
            sum: s64; squares: s64
            at := top + cast(s32)j
            for k: 0..2 * radius {
                value := cast(s64)input[at]
                sum += value; squares += value * value
                at += stride
            }
            column_sums[j] = sum; column_squares[j] = squares
        }
        for ix: 0..width + 1 {
            a: s64; b: s64
            for dx: 0..2 * radius { a += column_squares[ix + dx]; b += column_sums[ix + dx] }
            a = SgrRound(a, 2 * (bit_depth - 8))
            d := SgrRound(b, bit_depth - 8)
            p := a * n - d * d; if p < 0 { p = 0 }
            z := SgrRound(p * scale, 20)
            a2 := cast(s64)x_by_xplus1[ifx z < 255 then z else 255]
            a_values[iy * 10 + ix] = a2
            b_values[iy * 10 + ix] = SgrRound((256 - a2) * b * reciprocal, 12)
        }
    }
    for y: 0..height - 1 {
        result.error = CancellationError(cancellation)
        if result.error.code != DecodeOK { return result }
        shift: s32 = 5
        if pass == 0 && (y & 1) != 0 { shift = 4 }
        for x: 0..width - 1 {
            // 3x3 weights: pass 0 uses only the even rows, 5 at the sides and
            // 6 in the middle; pass 1 uses 4 on the cross and 3 at corners.
            at := cast(s32)y * 10 + cast(s32)x
            a: s64; b: s64
            if pass == 0 && (y & 1) == 0 {
                a = 5 * (a_values[at] + a_values[at + 2] + a_values[at + 20] + a_values[at + 22]) +
                    6 * (a_values[at + 1] + a_values[at + 21])
                b = 5 * (b_values[at] + b_values[at + 2] + b_values[at + 20] + b_values[at + 22]) +
                    6 * (b_values[at + 1] + b_values[at + 21])
            } else if pass == 0 {
                a = 5 * (a_values[at + 10] + a_values[at + 12]) + 6 * a_values[at + 11]
                b = 5 * (b_values[at + 10] + b_values[at + 12]) + 6 * b_values[at + 11]
            } else {
                a = 3 * (a_values[at] + a_values[at + 2] + a_values[at + 20] + a_values[at + 22]) +
                    4 * (a_values[at + 1] + a_values[at + 10] + a_values[at + 11] + a_values[at + 12] + a_values[at + 21])
                b = 3 * (b_values[at] + b_values[at + 2] + b_values[at + 20] + b_values[at + 22]) +
                    4 * (b_values[at + 1] + b_values[at + 10] + b_values[at + 11] + b_values[at + 12] + b_values[at + 21])
            }
            source := cast(s64)input[(y + 3) * stride + x + 3]
            result.samples[y * 8 + x] = SgrRound(a * source + b, 8 + shift - 4)
        }
    }
    return result
}

#scope_export
// Projection coefficients are the two LrSgrXqd values, not native decoded xq.
// Output stride is 8; inactive cells and all output on error are zero.
FilterSgrBlock :: (input: []u16, stride: s32, width: s32, height: s32,
    set: s32, projection0: s32, projection1: s32, bit_depth: s32,
    cancellation: *Cancellation = null) -> SgrBlock {
    result: SgrBlock
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    if (bit_depth != 8 && bit_depth != 10 && bit_depth != 12) || width < 1 || width > 8 || height < 1 || height > 8 ||
        stride < width + 6 || stride > 64 || input.count < cast(s64)(height + 5) * stride + width + 6 || input.count > 4096 ||
        set < 0 || set > 15 || projection0 < -96 || projection0 > 31 || projection1 < -32 || projection1 > 95 {
        result.error = Error(InvalidInput); return result
    }
    // Missing-radius coefficients are implicit in lr_params: xqd0=0, and
    // xqd1=Clip3(-32,95,128-xqd0)=95 for the allowed xqd0 range.
    if (SgrParameters(set, 0) == 0 && projection0 != 0) ||
        (SgrParameters(set, 2) == 0 && projection1 != 95) {
        result.error = Error(InvalidInput); return result
    }
    maximum := cast(s64)((cast(u64)1 << cast(u64)bit_depth) - 1)
    for y: 0..height + 5 { for x: 0..width + 5 {
        if cast(s64)input[y * stride + x] > maximum { result.error = Error(InvalidInput); return result }
    } }
    x_by_xplus1 := SgrXByXPlus1()
    pass0 := SgrBox(input, stride, width, height, set, 0, bit_depth, x_by_xplus1[:], cancellation)
    if pass0.error.code != DecodeOK { result.error = pass0.error; return result }
    pass1 := SgrBox(input, stride, width, height, set, 1, bit_depth, x_by_xplus1[:], cancellation)
    if pass1.error.code != DecodeOK { result.error = pass1.error; return result }
    radius0 := SgrParameters(set, 0); radius1 := SgrParameters(set, 2)
    w0 := cast(s64)projection0; w1 := cast(s64)projection1; w2 := 128 - w0 - w1
    samples: [64]u16
    for y: 0..height - 1 {
        result.error = CancellationError(cancellation)
        if result.error.code != DecodeOK { return result }
        for x: 0..width - 1 {
            u := cast(s64)input[(y + 3) * stride + x + 3] * 16
            v := w1 * u
            v += w0 * (ifx radius0 != 0 then pass0.samples[y * 8 + x] else u)
            v += w2 * (ifx radius1 != 0 then pass1.samples[y * 8 + x] else u)
            value := SgrRound(v, 11)
            if value < 0 { value = 0 }; if value > maximum { value = maximum }
            samples[y * 8 + x] = cast(u16)value
        }
    }
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    result.samples = samples; result.width = width; result.height = height
    return result
}
