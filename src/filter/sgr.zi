using Codec :: #import "image_codec/api"
Simd :: #import "std/simd"

// AV1 7.17.2/3 self-guided restoration on native-width s32 vectors.
// No allocation, native codec calls or frame scheduling. Caller
// supplies the resolved 3-pixel restoration halo, including pre-CDEF samples
// outside the restoration stripe.
SgrBlock :: struct { samples: [64]u16; width: s32; height: s32; error: DecodeError; }

// Sgr_Params row set: [r0, e0, r1, e1]; index 0/2 are the pass radii.
SgrParameterTable :: s32.[
    2,12,1,4,2,15,1,6,2,18,1,8,2,21,1,9,
    2,24,1,10,2,29,1,11,2,36,1,12,2,45,1,13,
    2,56,1,14,2,68,1,15,0,0,1,5,0,0,1,8,
    0,0,1,11,0,0,1,14,2,30,0,0,2,75,0,0]

SgrParameters :: (set: s32, pass: s32) -> s32 {
    return SgrParameterTable[set * 4 + pass]
}

#scope_file
// Kernel blocks are up to SgrMaximumWidth columns and 8 rows.
SgrMaximumWidth :: 64
// A and B rows: the block plus one sample on each side, padded to whole
// vectors.
SgrRow :: SgrMaximumWidth + 4
// A2 of each z, the reciprocal step of AV1 7.17.3: 1 at z 0,
// (z * 256 + z / 2) / (z + 1) below 255 and 256 from 255 on.
SgrXByXPlus1 :: s32.[
    1,128,171,192,205,213,219,224,228,230,233,235,236,238,239,240,
    241,242,243,243,244,244,245,245,246,246,247,247,247,247,248,248,
    248,248,249,249,249,249,249,250,250,250,250,250,250,250,251,251,
    251,251,251,251,251,251,251,251,252,252,252,252,252,252,252,252,
    252,252,252,252,252,252,252,252,252,253,253,253,253,253,253,253,
    253,253,253,253,253,253,253,253,253,253,253,253,253,253,253,253,
    253,253,253,253,253,253,254,254,254,254,254,254,254,254,254,254,
    254,254,254,254,254,254,254,254,254,254,254,254,254,254,254,254,
    254,254,254,254,254,254,254,254,254,254,254,254,254,254,254,254,
    254,254,254,254,254,254,254,254,254,254,254,254,254,254,254,254,
    254,254,254,254,254,254,254,254,254,254,255,255,255,255,255,255,
    255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,
    255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,
    255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,
    255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,
    255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,256]

SgrRoundValue :: (value: s32, shift: s32) -> s32 #inline {
    result := value
    if shift != 0 { result = (value + (cast(s32)1 << (shift - 1))) >> shift }
    return result
}

// The 3x3 weights of 7.17.3. Pass 0 has A and B on alternate rows only: an
// even output row weighs the rows above and below it, an odd row its own
// row, 5 at the sides and 6 in the middle. Pass 1 weighs the cross 4 and the
// corners 3.
SgrWeigh56Value :: (values: []s32, at: s64, down: s64) -> s32 #inline {
    sides := values[at] + values[at + 2] + values[at + down] + values[at + down + 2]
    middles := values[at + 1] + values[at + down + 1]
    return sides * 5 + middles * 6
}

SgrWeigh56RowValue :: (values: []s32, at: s64) -> s32 #inline {
    sides := values[at] + values[at + 2]
    middle := values[at + 1]
    return sides * 5 + middle * 6
}

SgrWeigh34Value :: (values: []s32, at: s64, up: s64) -> s32 #inline {
    corners := values[at] + values[at + 2] + values[at + 2 * up] + values[at + 2 * up + 2]
    cross := values[at + 1] + values[at + up] + values[at + up + 1] +
        values[at + up + 2] + values[at + 2 * up + 1]
    return corners * 3 + cross * 4
}

SgrProjectValue :: (source: s32, first: s32, second: s32,
    projection0: s32, projection1: s32) -> s32 #inline {
    projection2 := 128 - projection0 - projection1
    return projection1 * source + projection0 * first + projection2 * second
}

// One pass of 7.17.3 into output rows SgrMaximumWidth apart. Every value
// fits s32 lanes: box sums of squares stay below 2^29 at 12 bits, p is
// clamped where z already reaches 255, and (256 - A) * B * reciprocal stays
// below 2^32, so it is formed in u32 lanes.
SgrBoxPass :: (input: []u16, stride: s32, width: s32, height: s32,
    set: s32, radius: s32, pass: s32, bit_depth: s32, output: []s32) #inline {
    // The caller validated these; as comparisons they prove the indexes
    // below. Short guards keep each proof's fact set small.
    if radius < 1 || radius > 2 { return }
    if width < 1 || width > SgrMaximumWidth || height < 1 || height > 8 || stride < width + 6 || stride > 72 { return }
    if input.count < cast(s64)(height + 5) * stride + width + 6 || output.count < cast(s64)height * SgrMaximumWidth { return }
    epsilon := cast(s64)SgrParameters(set, pass * 2 + 1)
    n := cast(s64)((2 * radius + 1) * (2 * radius + 1))
    n2e := n * n * epsilon
    scale: s64 = (1048576 + n2e / 2) / n2e
    reciprocal: s64 = (4096 + n / 2) / n
    // From p_limit on, p * scale + 2^19 >= 255 * 2^20, so z is 255.
    p_limit := (255 * 1048576 - 524288 + scale - 1) / scale
    a_values: [680]s32; b_values: [680]s32
    // Column j sums input column j + 2 - radius over the 2 * radius + 1
    // rows centred on row iy + 2.
    sums: [80]s32; squares: [80]s32
    columns := cast(s64)(width + 2 + 2 * radius)
    shift_a := 2 * (bit_depth - 8); shift_b := bit_depth - 8
    wide := Simd.Lanes(s32xN)
    zero := Simd.Zero(s32xN)
    lanes_n := Simd.Splat(s32xN, cast(s32)n); lanes_scale := Simd.Splat(s32xN, cast(s32)scale)
    p_limit_value := cast(s32)p_limit
    lanes_limit := Simd.Splat(s32xN, p_limit_value)
    lanes_255 := Simd.Splat(s32xN, 255); lanes_256 := Simd.Splat(s32xN, 256)
    lanes_reciprocal := Simd.Splat(u32xN, cast(u32)reciprocal)
    for iy: 0..height + 1 {
        // The radius-2 pass is combined from even rows of A and B only.
        if pass == 0 && (iy & 1) != 0 { continue }
        top := (cast(s64)iy + 2 - radius) * stride + 2 - radius
        j: s64 = 0
        while j + wide <= columns {
            s := zero; q := zero
            for k: 0..2 * radius {
                v := Simd.Reinterpret(s32xN, Simd.WidenLow(
                    Simd.LoadLow(u16xN, input, top + k * stride + j)))
                s = Simd.Add(s, v); q = Simd.Add(q, Simd.Mul(v, v))
            }
            Simd.Store(sums[:], j, s); Simd.Store(squares[:], j, q)
            j += wide
        }
        while j < columns {
            s: s32; q: s32
            for k: 0..2 * radius { v := cast(s32)input[top + k * stride + j]; s += v; q += v * v }
            sums[j] = s; squares[j] = q
            j += 1
        }
        // Whole vectors cover interior A/B columns; the remaining halo columns
        // use scalar values without reading beyond the box sums.
        row := cast(s64)iy * SgrRow
        ix: s64 = 0
        while ix + wide <= cast(s64)width + 1 {
            a := zero; b := zero
            for dx: 0..2 * radius {
                a = Simd.Add(a, Simd.Load(s32xN, squares[:], ix + dx)); b = Simd.Add(b, Simd.Load(s32xN, sums[:], ix + dx))
            }
            rounded_a := ifx shift_a == 0 then a else Simd.ShiftRightRound(a, cast(u32)shift_a)
            rounded_b := ifx shift_b == 0 then b else Simd.ShiftRightRound(b, cast(u32)shift_b)
            p := Simd.Sub(Simd.Mul(rounded_a, lanes_n), Simd.Mul(rounded_b, rounded_b))
            p = Simd.Min(Simd.Max(p, zero), lanes_limit)
            z := Simd.Min(Simd.ShiftRightRound(Simd.Mul(p, lanes_scale), 20), lanes_255)
            a2 := Simd.Gather(SgrXByXPlus1, z)
            t := Simd.Reinterpret(u32xN, Simd.Mul(Simd.Sub(lanes_256, a2), b))
            b2 := Simd.Reinterpret(s32xN, Simd.ShiftRightRound(Simd.Mul(t, lanes_reciprocal), 12))
            Simd.Store(a_values[:], row + ix, a2); Simd.Store(b_values[:], row + ix, b2)
            ix += wide
        }
        while ix < cast(s64)width + 2 {
            a: s32; b: s32
            for dx: 0..2 * radius { a += squares[ix + dx]; b += sums[ix + dx] }
            d := SgrRoundValue(b, shift_b)
            p := SgrRoundValue(a, shift_a) * cast(s32)n - d * d
            if p < 0 { p = 0 }; if p > p_limit_value { p = p_limit_value }
            z := (p * cast(s32)scale + 524288) >> 20
            if z > 255 { z = 255 }
            a2 := SgrXByXPlus1[z]
            t := (cast(u32)(256 - a2) * cast(u32)b * cast(u32)reciprocal + 2048) >> 12
            a_values[row + ix] = a2; b_values[row + ix] = cast(s32)t
            ix += 1
        }
    }
    up: s64 = SgrRow; down: s64 = 2 * SgrRow
    for y: 0..cast(s64)height - 1 {
        shift: u32 = 9
        if pass == 0 && (y & 1) != 0 { shift = 8 }
        x: s64 = 0
        while x + wide <= cast(s64)width {
            at := y * up + x
            a: s32xN; b: s32xN
            if pass == 0 && (y & 1) == 0 {
                a_sides := Simd.Add(Simd.Add(Simd.Load(s32xN, a_values[:], at), Simd.Load(s32xN, a_values[:], at + 2)),
                    Simd.Add(Simd.Load(s32xN, a_values[:], at + down), Simd.Load(s32xN, a_values[:], at + down + 2)))
                a_middles := Simd.Add(Simd.Load(s32xN, a_values[:], at + 1), Simd.Load(s32xN, a_values[:], at + down + 1))
                a = Simd.Add(Simd.Add(Simd.ShiftLeft(a_sides, 2), a_sides),
                    Simd.Add(Simd.ShiftLeft(a_middles, 2), Simd.ShiftLeft(a_middles, 1)))
                b_sides := Simd.Add(Simd.Add(Simd.Load(s32xN, b_values[:], at), Simd.Load(s32xN, b_values[:], at + 2)),
                    Simd.Add(Simd.Load(s32xN, b_values[:], at + down), Simd.Load(s32xN, b_values[:], at + down + 2)))
                b_middles := Simd.Add(Simd.Load(s32xN, b_values[:], at + 1), Simd.Load(s32xN, b_values[:], at + down + 1))
                b = Simd.Add(Simd.Add(Simd.ShiftLeft(b_sides, 2), b_sides),
                    Simd.Add(Simd.ShiftLeft(b_middles, 2), Simd.ShiftLeft(b_middles, 1)))
            } else if pass == 0 {
                a_sides := Simd.Add(Simd.Load(s32xN, a_values[:], at + up), Simd.Load(s32xN, a_values[:], at + up + 2))
                a_middle := Simd.Load(s32xN, a_values[:], at + up + 1)
                a = Simd.Add(Simd.Add(Simd.ShiftLeft(a_sides, 2), a_sides),
                    Simd.Add(Simd.ShiftLeft(a_middle, 2), Simd.ShiftLeft(a_middle, 1)))
                b_sides := Simd.Add(Simd.Load(s32xN, b_values[:], at + up), Simd.Load(s32xN, b_values[:], at + up + 2))
                b_middle := Simd.Load(s32xN, b_values[:], at + up + 1)
                b = Simd.Add(Simd.Add(Simd.ShiftLeft(b_sides, 2), b_sides),
                    Simd.Add(Simd.ShiftLeft(b_middle, 2), Simd.ShiftLeft(b_middle, 1)))
            } else {
                a_corners := Simd.Add(Simd.Add(Simd.Load(s32xN, a_values[:], at), Simd.Load(s32xN, a_values[:], at + 2)),
                    Simd.Add(Simd.Load(s32xN, a_values[:], at + 2 * up), Simd.Load(s32xN, a_values[:], at + 2 * up + 2)))
                a_cross := Simd.Add(Simd.Add(Simd.Load(s32xN, a_values[:], at + 1), Simd.Load(s32xN, a_values[:], at + up)),
                    Simd.Add(Simd.Add(Simd.Load(s32xN, a_values[:], at + up + 1), Simd.Load(s32xN, a_values[:], at + up + 2)),
                    Simd.Load(s32xN, a_values[:], at + 2 * up + 1)))
                a = Simd.Add(Simd.Add(Simd.ShiftLeft(a_corners, 1), a_corners), Simd.ShiftLeft(a_cross, 2))
                b_corners := Simd.Add(Simd.Add(Simd.Load(s32xN, b_values[:], at), Simd.Load(s32xN, b_values[:], at + 2)),
                    Simd.Add(Simd.Load(s32xN, b_values[:], at + 2 * up), Simd.Load(s32xN, b_values[:], at + 2 * up + 2)))
                b_cross := Simd.Add(Simd.Add(Simd.Load(s32xN, b_values[:], at + 1), Simd.Load(s32xN, b_values[:], at + up)),
                    Simd.Add(Simd.Add(Simd.Load(s32xN, b_values[:], at + up + 1), Simd.Load(s32xN, b_values[:], at + up + 2)),
                    Simd.Load(s32xN, b_values[:], at + 2 * up + 1)))
                b = Simd.Add(Simd.Add(Simd.ShiftLeft(b_corners, 1), b_corners), Simd.ShiftLeft(b_cross, 2))
            }
            source := Simd.Reinterpret(s32xN, Simd.WidenLow(
                Simd.LoadLow(u16xN, input, (y + 3) * stride + x + 3)))
            Simd.Store(output, y * SgrMaximumWidth + x, Simd.ShiftRightRound(Simd.Add(Simd.Mul(a, source), b), shift))
            x += wide
        }
        while x < cast(s64)width {
            at := y * up + x
            a: s32; b: s32
            if pass == 0 && (y & 1) == 0 {
                a = SgrWeigh56Value(a_values[:], at, down); b = SgrWeigh56Value(b_values[:], at, down)
            } else if pass == 0 {
                a = SgrWeigh56RowValue(a_values[:], at + up); b = SgrWeigh56RowValue(b_values[:], at + up)
            } else {
                a = SgrWeigh34Value(a_values[:], at, up); b = SgrWeigh34Value(b_values[:], at, up)
            }
            source := cast(s32)input[(y + 3) * stride + x + 3]
            output[y * SgrMaximumWidth + x] = SgrRoundValue(a * source + b, cast(s32)shift)
            x += 1
        }
    }
}

SgrBox :: (input: []u16, stride: s32, width: s32, height: s32,
    set: s32, pass: s32, bit_depth: s32, output: []s32) #target {
    radius := SgrParameters(set, pass * 2)
    if radius < 1 || radius > 2 { return }
    if width < 1 || width > SgrMaximumWidth || height < 1 || height > 8 || stride < width + 6 || stride > 72 { return }
    if input.count < cast(s64)(height + 5) * stride + width + 6 || output.count < cast(s64)height * SgrMaximumWidth { return }
    if pass == 0 && radius == 1 { SgrBoxPass(input, stride, width, height, set, 1, 0, bit_depth, output); return }
    if pass == 0 && radius == 2 { SgrBoxPass(input, stride, width, height, set, 2, 0, bit_depth, output); return }
    if pass == 1 && radius == 1 { SgrBoxPass(input, stride, width, height, set, 1, 1, bit_depth, output); return }
    SgrBoxPass(input, stride, width, height, set, 2, 1, bit_depth, output)
}

// The projection of 7.17.3 over both passes, a pass without a radius
// standing in with the scaled source.
SgrProject :: (input: []u16, stride: s32, width: s32, height: s32, set: s32,
    projection0: s32, projection1: s32, bit_depth: s32, pass0: []s32, pass1: []s32, output: []u16, output_stride: s32) #target {
    if width < 1 || width > SgrMaximumWidth || height < 1 || height > 8 || stride < width + 6 || stride > 72 { return }
    if input.count < cast(s64)(height + 5) * stride + width + 6 || pass0.count < cast(s64)height * SgrMaximumWidth ||
        pass1.count < cast(s64)height * SgrMaximumWidth || output_stride < width ||
        output.count < (cast(s64)height - 1) * output_stride + width {
        return
    }
    radius0 := SgrParameters(set, 0); radius1 := SgrParameters(set, 2)
    wide := Simd.Lanes(s32xN)
    zero := Simd.Zero(s32xN)
    maximum := Simd.Splat(s32xN, cast(s32)((cast(u32)1 << cast(u32)bit_depth) - 1))
    half := Simd.Splat(s32xN, 1024)
    w0 := Simd.Splat(s32xN, projection0); w1 := Simd.Splat(s32xN, projection1)
    w2 := Simd.Splat(s32xN, 128 - projection0 - projection1)
    for y: 0..cast(s64)height - 1 {
        x: s64 = 0
        while x + wide <= cast(s64)width {
            u := Simd.ShiftLeft(Simd.Reinterpret(s32xN, Simd.WidenLow(
                Simd.LoadLow(u16xN, input, (y + 3) * stride + x + 3))), 4)
            first := ifx radius0 != 0 then Simd.Load(s32xN, pass0, y * SgrMaximumWidth + x) else u
            second := ifx radius1 != 0 then Simd.Load(s32xN, pass1, y * SgrMaximumWidth + x) else u
            v := Simd.Add(Simd.Mul(w1, u), Simd.Add(Simd.Mul(w0, first), Simd.Mul(w2, second)))
            // Round2 of a signed sum floors: the arithmetic shift does.
            value := Simd.Min(Simd.Max(Simd.ShiftRight(Simd.Add(v, half), 11), zero), maximum)
            at := y * output_stride + x
            Simd.StoreLow(output, at, Simd.Narrow(u16xN, value, value))
            x += wide
        }
        while x < cast(s64)width {
            u := cast(s32)input[(y + 3) * stride + x + 3] << 4
            first := ifx radius0 != 0 then pass0[y * SgrMaximumWidth + x] else u
            second := ifx radius1 != 0 then pass1[y * SgrMaximumWidth + x] else u
            v := SgrProjectValue(u, first, second, projection0, projection1)
            value := (v + 1024) >> 11
            if value < 0 { value = 0 }
            top := cast(s32)((cast(u32)1 << cast(u32)bit_depth) - 1)
            if value > top { value = top }
            output[y * output_stride + x] = cast(u16)value
            x += 1
        }
    }
}

#scope_export
// Projection coefficients are the two LrSgrXqd values, not native decoded xq.
// Output stride is 8; inactive cells and all output on error are zero.
FilterSgrBlock :: (input: []u16, stride: s32, width: s32, height: s32,
    set: s32, projection0: s32, projection1: s32, bit_depth: s32,
    cancellation: *Cancellation = null) -> SgrBlock {
    result: SgrBlock
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    if (bit_depth != 8 && bit_depth != 10 && bit_depth != 12) || width < 1 || width > 8 || height < 1 || height > 8 ||
        stride < width + 6 || stride > 64 || input.count < cast(s64)(height + 5) * stride + width + 6 || input.count > 4096 ||
        set < 0 || set > 15 || projection0 < -96 || projection0 > 31 || projection1 < -32 || projection1 > 95 {
        result.error = Error(InvalidInput); return result
    }
    // Missing-radius coefficients are implicit in lr_params: xqd0=0, and
    // xqd1=Clip3(-32,95,128-xqd0)=95 for the allowed xqd0 range.
    if (SgrParameters(set, 0) == 0 && projection0 != 0) ||
        (SgrParameters(set, 2) == 0 && projection1 != 95) {
        result.error = Error(InvalidInput); return result
    }
    maximum := cast(s64)((cast(u64)1 << cast(u64)bit_depth) - 1)
    for y: 0..height + 5 { for x: 0..width + 5 {
        if cast(s64)input[y * stride + x] > maximum { result.error = Error(InvalidInput); return result }
    } }
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    // Output commits only after the last cancellation check.
    samples: [64]u16
    SgrFilterInto(input, stride, width, height, set, projection0, projection1, bit_depth, samples[:], 8)
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    result.samples = samples; result.width = width; result.height = height
    return result
}

// The filter of a validated block up to SgrMaximumWidth wide, written to
// output rows output_stride apart.
SgrFilterInto :: (input: []u16, stride: s32, width: s32, height: s32,
    set: s32, projection0: s32, projection1: s32, bit_depth: s32, output: []u16, output_stride: s32) {
    pass0: [512]s32; pass1: [512]s32
    SgrBox(input, stride, width, height, set, 0, bit_depth, pass0[:])
    SgrBox(input, stride, width, height, set, 1, bit_depth, pass1[:])
    SgrProject(input, stride, width, height, set, projection0, projection1, bit_depth, pass0[:], pass1[:], output, output_stride)
}
