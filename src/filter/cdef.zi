using Codec :: #import "image_codec/api"
Simd :: #import "std/simd"

// AV1 scalar CDEF direction/filter semantics. Reference tables also appear in
// libaom d772e334cc724105040382a977ebb10dfd393293, av1/common/cdef_block.c.
// Copyright (c) 2016, Alliance for Open Media. BSD2/AOM Patent notices retained
// in LICENSE.libaom and PATENTS.libaom. No allocation or native codec calls.
CdefMissingSample :: 30000
CdefDirection :: struct { direction: s32; variance: u32; error: DecodeError; }
CdefBlock :: struct { samples: [64]u16; width: s32; height: s32; error: DecodeError; }

FindCdefDirection :: (input: []u16, stride: s32, bit_depth: s32,
    cancellation: *Cancellation = null) -> CdefDirection {
    result: CdefDirection
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    if (bit_depth != 8 && bit_depth != 10 && bit_depth != 12) || stride < 8 || stride > 64 ||
        input.count < 7 * cast(s64)stride + 8 || input.count > 4096 { result.error = Error(InvalidInput); return result }
    maximum := cast(u32)((cast(u32)1 << cast(u32)bit_depth) - 1)
    block: CdefLumaBlock
    for row: 0..7 {
        for column: 0..7 {
            value := input[row * stride + column]
            if cast(u32)value > maximum { result.error = Error(InvalidInput); return result }
            block.samples[row * 8 + column] = value
        }
    }
    found := CdefDirectionOf(*block, bit_depth)
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    result.direction = found.direction; result.variance = found.variance
    return result
}

CdefLumaBlock :: struct { samples: [64]u16; }

// The direction search alone, for an 8x8 block of real samples at bit_depth
// 8, 10 or 12, row r column c at samples[r * 8 + c]. Centred on zero, a line
// of n samples sums to at most 128 * n in magnitude, and its cost weight is
// 840 / n, so every direction costs at most 128 * 128 * 840 * 64 and all
// arithmetic fits 32 bits.
CdefDirectionOf :: (block: *CdefLumaBlock, bit_depth: s32) -> CdefDirection {
    result: CdefDirection
    shift := cast(u32)(bit_depth - 8) & 7
    partial: [120]s32
    for row: 0..7 {
        for column: 0..7 {
            value := cast(s32)(block.samples[row * 8 + column] >> shift) - 128
            partial[row + column] += value
            partial[15 + row + column / 2] += value
            partial[30 + row] += value
            partial[45 + 3 + row - column / 2] += value
            partial[60 + 7 + row - column] += value
            partial[75 + 3 - row / 2 + column] += value
            partial[90 + column] += value
            partial[105 + row / 2 + column] += value
        }
    }
    divisors: [9]s32 = .[0,840,420,280,210,168,140,120,105]
    cost: [8]s32
    for i: 0..7 {
        cost[2] += partial[30 + i] * partial[30 + i]
        cost[6] += partial[90 + i] * partial[90 + i]
    }
    cost[2] *= divisors[8]; cost[6] *= divisors[8]
    for i: 0..6 {
        cost[0] += (partial[i] * partial[i] + partial[14 - i] * partial[14 - i]) * divisors[i + 1]
        cost[4] += (partial[60 + i] * partial[60 + i] + partial[74 - i] * partial[74 - i]) * divisors[i + 1]
    }
    cost[0] += partial[7] * partial[7] * divisors[8]
    cost[4] += partial[67] * partial[67] * divisors[8]
    for direction: 1..7 {
        if direction % 2 == 0 { continue }
        for j: 0..4 { cost[direction] += partial[direction * 15 + 3 + j] * partial[direction * 15 + 3 + j] }
        cost[direction] *= divisors[8]
        for j: 0..2 {
            a := partial[direction * 15 + j]; b := partial[direction * 15 + 10 - j]
            cost[direction] += (a * a + b * b) * divisors[2 * j + 2]
        }
    }
    best: s32
    for direction: 1..7 { if cost[direction] > cost[best] { best = cast(s32)direction } }
    result.direction = best
    // The best cost is the largest, so the difference is never negative.
    result.variance = cast(u32)((cost[best] - cost[(best + 4) & 7]) >> 10)
    return result
}

#scope_file
// Damping shift of the constrain function for a non-zero threshold.
CdefDampingShift :: (threshold: s32, damping: s32) -> u32 {
    log: s32; remaining := threshold
    while remaining > 1 { log += 1; remaining /= 2 }
    shift := damping - log; if shift < 0 { shift = 0 }
    return cast(u32)shift
}

#scope_export
// Input starts at the top-left of a two-sample halo. Missing neighbors must
// equal CdefMissingSample; center samples must be real source-depth samples.
// Strengths and damping include bit_depth-8 scaling. Luma primary strength
// includes the normative variance adjustment, which need not preserve scaling.
// Width/height are 4 or 8; output stride is 8. Nothing commits after an error.
FilterCdefBlock :: (input: []u16, stride: s32, width: s32, height: s32,
    primary_strength: s32, secondary_strength: s32, damping: s32,
    direction: s32, bit_depth: s32, cancellation: *Cancellation = null) -> CdefBlock {
    result: CdefBlock
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    if (bit_depth != 8 && bit_depth != 10 && bit_depth != 12) ||
        (width != 4 && width != 8) || (height != 4 && height != 8) || stride < width + 4 || stride > 64 ||
        input.count < cast(s64)(height + 3) * stride + width + 4 || input.count > 4096 || direction < 0 || direction > 7 {
        result.error = Error(InvalidInput); return result
    }
    shift := bit_depth - 8
    scale := cast(s32)(cast(u32)1 << cast(u32)shift)
    maximum := cast(u32)((cast(u32)1 << cast(u32)bit_depth) - 1)
    if primary_strength < 0 || primary_strength > 15 * scale ||
        secondary_strength < 0 || secondary_strength > 4 * scale || secondary_strength % scale != 0 ||
        secondary_strength / scale == 3 || damping < 2 + shift || damping > 6 + shift {
        result.error = Error(InvalidInput); return result
    }
    for row: 0..height + 3 {
        for column: 0..width + 3 {
            sample := input[row * stride + column]
            if sample == CdefMissingSample {
                if row >= 2 && row < height + 2 && column >= 2 && column < width + 2 {
                    result.error = Error(InvalidInput); return result
                }
            } else if cast(u32)sample > maximum { result.error = Error(InvalidInput); return result }
        }
    }
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    block: CdefPadded
    for row: 0..height + 3 { for column: 0..width + 3 { block.samples[row * 16 + column] = input[row * stride + column] } }
    // Output commits only after the last cancellation check.
    samples: [64]u16
    CdefFilterPadded(*block, width, height, primary_strength, secondary_strength, damping, direction,
        bit_depth, samples[:], 8)
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    result.samples = samples; result.width = width; result.height = height
    return result
}

CdefPadded :: struct { samples: [256]u16; }

// The filter of a validated block padded to 16 samples per row: halo row r,
// column c is samples[r * 16 + c], written to output rows output_stride
// apart. Each pass filters eight samples as one s16x8 vector, one row of an
// 8-wide block or two rows of a 4-wide one. Every intermediate fits s16:
// samples and the missing value are at most 30000, constrained differences
// at most 240 and the weighted sum at most 12 * 4 * 240.
// A missing neighbor is 30000, at least 25905 above any sample; shifted by at
// most 10 - log2(threshold) its magnitude still exceeds the threshold, so its
// constrained difference is zero and it is left out of the maximum only.
// Taps of a zero strength add nothing; with a single nonzero strength the
// weights sum to 12, so the result already lies within the taps' range and the
// clamp is skipped.
CdefFilterPadded :: (block: *CdefPadded, width: s32, height: s32,
    primary_strength: s32, secondary_strength: s32, damping: s32, direction: s32, bit_depth: s32,
    output: []u16, output_stride: s32) #target {
    scale := cast(s32)(cast(u32)1 << cast(u32)(bit_depth - 8))
    directions: [32]s32 = .[-1,1,-2,2,0,1,-1,2,0,1,0,2,0,1,1,2,1,1,2,2,1,0,2,1,1,0,2,0,1,0,2,-1]
    primary_taps: [4]s32 = .[4,2,3,3]
    // Offsets are from the top-left halo sample to the neighbor of the
    // centre sample (row 2, column 2), so they are never negative.
    tap_offsets: [12]s64; tap_weights: [12]s32; tap_thresholds: [12]s32; tap_shifts: [12]s32
    taps: s32 = 0
    for tap: 0..1 {
        for family: 0..2 {
            filter_direction := direction; strength := primary_strength
            weight := primary_taps[(primary_strength / scale & 1) * 2 + tap]
            if family > 0 {
                offset: s32 = ifx family == 1 then 6 else 2
                filter_direction = (direction + offset) % 8
                strength = secondary_strength
                weight = ifx tap == 0 then 2 else 1
            }
            if strength == 0 { continue }
            for side: 0..1 {
                sign: s32 = ifx side == 0 then -1 else 1
                tap_offsets[taps] = cast(s64)(34 + sign * (directions[(filter_direction * 2 + tap) * 2] * 16 +
                    directions[(filter_direction * 2 + tap) * 2 + 1]))
                tap_weights[taps] = weight; tap_thresholds[taps] = strength
                tap_shifts[taps] = cast(s32)CdefDampingShift(strength, damping)
                taps += 1
            }
        }
    }
    clamp := primary_strength != 0 && secondary_strength != 0
    rows: s64 = ifx width == 4 then 2 else 1
    zero := Simd.Zero(s16x8)
    missing := Simd.Splat(s16x8, cast(s16)CdefMissingSample)
    eight := Simd.Splat(s16x8, 8)
    for pass: 0..7 {
        first := pass * rows
        if first >= cast(s64)height || first > 7 { break }
        line := first * 16
        // In a 4-wide block the second row's four samples are the upper lanes.
        current: s16x8
        if width == 4 {
            upper := Simd.Reinterpret(u64x2, Simd.LoadLow(u16x8, block.samples, line + 34))
            lower := Simd.Reinterpret(u64x2, Simd.LoadLow(u16x8, block.samples, line + 50))
            current = Simd.Reinterpret(s16x8, Simd.InterleaveLow(upper, lower))
        } else {
            current = Simd.Reinterpret(s16x8, Simd.Load(u16x8, block.samples, line + 34))
        }
        sums := zero; lows := current; highs := current
        for tap: 0..11 {
            if tap >= cast(s64)taps { break }
            // Offsets lie in 0..68, so every read stays in the block.
            offset := tap_offsets[tap]
            threshold := Simd.Splat(s16x8, cast(s16)tap_thresholds[tap])
            shift := tap_shifts[tap] & 15
            weight := Simd.Splat(s16x8, cast(s16)tap_weights[tap])
            if offset < 0 || offset > 68 { continue }
            value: s16x8
            if width == 4 {
                upper := Simd.Reinterpret(u64x2, Simd.LoadLow(u16x8, block.samples, line + offset))
                lower := Simd.Reinterpret(u64x2, Simd.LoadLow(u16x8, block.samples, line + offset + 16))
                value = Simd.Reinterpret(s16x8, Simd.InterleaveLow(upper, lower))
            } else {
                value = Simd.Reinterpret(s16x8, Simd.Load(u16x8, block.samples, line + offset))
            }
            difference := Simd.Sub(value, current)
            magnitude := Simd.Abs(difference)
            constrained := Simd.Max(zero, Simd.Sub(threshold, Simd.ShiftRight(magnitude, shift)))
            constrained = Simd.Min(constrained, magnitude)
            signed := Simd.Select(Simd.Less(difference, zero), Simd.Neg(constrained), constrained)
            sums = Simd.Add(sums, Simd.Mul(weight, signed))
            lows = Simd.Min(lows, value)
            highs = Simd.Max(highs, Simd.AndNot(value, Simd.Equal(value, missing)))
        }
        // (8 + sum - (sum < 0)) >> 4, the comparison being -1 where sum < 0.
        result := Simd.Add(current, Simd.ShiftRight(Simd.Add(Simd.Add(sums, eight), Simd.Less(sums, zero)), 4))
        if clamp { result = Simd.Min(Simd.Max(result, lows), highs) }
        out := Simd.Reinterpret(u16x8, result)
        if width == 4 {
            Simd.StoreLow(output, first * output_stride, out)
            Simd.StoreLow(output, (first + 1) * output_stride, Simd.ShiftBytesRight(out, 8))
        } else {
            Simd.Store(output, first * output_stride, out)
        }
    }
}
