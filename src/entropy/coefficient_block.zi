#import, file "./range.zi";
#import, file "./coefficient_cdfs.zi";
#import, file "./coefficient_cdf_symbols.zi";
#import, file "./coefficient_scan.zi";
#import, file "./coefficient_context.zi";

#import, file "./coefficient_geometry.zi";
CoefficientBlock :: struct {
    quant: [1024]s32;
    eob: s32;
    level: s32;
    dc_category: s32;
    coded_width: s32;
    coded_height: s32;
    error: DecodeError;
}

CoefficientBlockFailure :: (error: DecodeError) -> CoefficientBlock {
    result: CoefficientBlock; result.error = error; return result
}

// DecodeNonzeroCoefficients' result; the coefficients go to the caller's buffer.
CoefficientSummary :: struct {
    eob: s32;
    level: s32;
    dc_category: s32;
    coded_width: s32;
    coded_height: s32;
    // How many coefficients are nonzero; their coded positions lead the
    // scratch's nonzero list.
    nonzero: s32;
    error: DecodeError;
}

// Working buffers of DecodeNonzeroCoefficients that a tile keeps, so a block
// clears only the levels it reads instead of zeroing both arrays.
CoefficientScratch :: struct { levels: [1296]u8; positions: [1024]u16; nonzero: [1024]u16; }

CoefficientSummaryFailure :: (error: DecodeError) -> CoefficientSummary {
    result: CoefficientSummary; result.error = error; return result
}

// Read before transform-type syntax. On nonzero luma the caller reads that
// syntax, resolves the legal plane transform, then calls ReadNonzeroCoefficients.
ReadCoefficientSkip :: (decoder: *RangeDecoder, cdfs: *CoefficientCDFs,
    width: s32, height: s32, plane: s32, skip_context: s32,
    cancellation: *Cancellation = null) -> CoefficientSymbol {
    result: CoefficientSymbol; result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    shape := GetCoefficientShape(width, height)
    if shape.error.code != DecodeOK { result.error = shape.error; return result }
    if plane < 0 || plane > 1 || skip_context < 0 || skip_context > 12 ||
        (plane == 0 && skip_context > 6) || (plane == 1 && skip_context < 7) {
        result.error = Error(InvalidInput); return result
    }
    if decoder == null || cdfs == null { result.error = Error(InvalidInput); return result }
    if decoder.error.code != DecodeOK { result.error = decoder.error; return result }
    if cdfs.error.code != DecodeOK { result.error = cdfs.error; return result }
    // The skip CDF row, as SelectCoefficientCDF lays it out.
    at := (shape.size_context * 13 + skip_context) * 3
    result.value = DecodeSymbol(decoder, cdfs.values[at:at + 3])
    result.error = decoder.error
    return result
}

// Nonzero coefficient payload, AV1 coeffs syntax. Transform type is already
// resolved; this routine does not parse or validate a frame's transform set.
// tx_class uses AV1 2D/horizontal/vertical values; compact quant output is
// row-major. A failure commits no block; entropy/CDF state is consumed and the
// caller must discard that tile. No allocation or external decoder is used.
ReadNonzeroCoefficients :: (decoder: *RangeDecoder, cdfs: *CoefficientCDFs,
    width: s32, height: s32, tx_class: s32, plane: s32, dc_context: s32,
    cancellation: *Cancellation = null) -> CoefficientBlock {
    result: CoefficientBlock; scratch: CoefficientScratch
    summary := DecodeNonzeroCoefficients(decoder, cdfs, width, height, tx_class, plane, dc_context,
        result.quant[:], *scratch, cancellation)
    if summary.error.code != DecodeOK { return CoefficientBlockFailure(summary.error) }
    result.eob = summary.eob; result.level = summary.level; result.dc_category = summary.dc_category
    result.coded_width = summary.coded_width; result.coded_height = summary.coded_height
    return result
}

// ReadNonzeroCoefficients into quant, the caller's compact row-major buffer of
// at least the coded count. On failure quant holds partial values.
DecodeNonzeroCoefficients :: (decoder: *RangeDecoder, cdfs: *CoefficientCDFs,
    width: s32, height: s32, tx_class: s32, plane: s32, dc_context: s32, quant: []s32,
    scratch: *CoefficientScratch, cancellation: *Cancellation = null) -> CoefficientSummary {
    error := CancellationError(cancellation)
    if error.code != DecodeOK { return CoefficientSummaryFailure(error) }
    if decoder == null || cdfs == null || scratch == null || plane < 0 || plane > 1 || dc_context < 0 || dc_context > 2 ||
        tx_class < 0 || tx_class > 2 {
        return CoefficientSummaryFailure(Error(InvalidInput))
    }
    shape := GetCoefficientShape(width, height)
    if shape.error.code != DecodeOK { return CoefficientSummaryFailure(shape.error) }
    if (tx_class != CoefficientClass2D && (width > 16 || height > 16)) || quant.count < cast(s64)shape.count {
        return CoefficientSummaryFailure(Error(InvalidInput))
    }
    mode: s32 = ScanDefault
    if tx_class == CoefficientClassHorizontal { mode = ScanColumns }
    if tx_class == CoefficientClassVertical { mode = ScanRows }
    if decoder.error.code != DecodeOK { return CoefficientSummaryFailure(decoder.error) }
    if cdfs.error.code != DecodeOK { return CoefficientSummaryFailure(cdfs.error) }
    // CDF rows of this block's size and plane, as SelectCoefficientCDF lays them out.
    row_plane := shape.size_context * 2 + plane
    points := shape.area + 6
    at := 3583 + 2 * shape.area * (shape.area + 11) + (plane * 2 + ifx tx_class == CoefficientClass2D then 0 else 1) * points
    point := DecodeSymbol(decoder, cdfs.values[at:at + points]) + 1
    if decoder.error.code != DecodeOK { return CoefficientSummaryFailure(decoder.error) }
    eob := ifx point < 2 then point else cast(s32)(cast(u32)1 << cast(u32)(point - 2)) + 1
    if point >= 3 {
        at = 3313 + (row_plane * 9 + point - 3) * 3
        eob += cast(s32)(cast(u32)DecodeSymbol(decoder, cdfs.values[at:at + 3]) << cast(u32)(point - 3))
        bit := point - 4
        while bit >= 0 {
            eob += cast(s32)(ReadBool(decoder) << cast(u32)bit); bit -= 1
        }
    }
    if decoder.error.code != DecodeOK { return CoefficientSummaryFailure(decoder.error) }
    if eob < 1 || eob > shape.count { return CoefficientSummaryFailure(Error(MalformedInput, RangeByte(decoder))) }
    cw := ifx width < 32 then width else 32; ch := ifx height < 32 then height else 32
    log_width: s32 = 2
    while (cast(s32)1 << log_width) < cw { log_width += 1 }
    positions := scratch.positions[:]
    CoefficientScanPrefix(positions, cw, ch, mode, eob)
    base_cdfs := 213 + row_plane * 42 * 5
    eob_cdfs := 3153 + row_plane * 4 * 4
    br_cdfs := 2313 + ((ifx shape.size_context > 3 then 3 else shape.size_context) * 2 + plane) * 21 * 5
    stride := CoefficientLevelStride(cw)
    for i: 0..shape.count - 1 { quant[i] = 0 }
    // Contexts read at most four rows and columns past the coded block.
    levels := scratch.levels[:cast(s64)(ch + 4) * stride]
    for i: 0..levels.count - 1 { levels[i] = 0 }
    result: CoefficientSummary
    // The scan indices of nonzero levels, last first.
    nonzero := scratch.nonzero[:]
    nonzero_count: s32
    index := eob - 1
    while index >= 0 {
        position := cast(s32)positions[index]
        row := position >> log_width; column := position & (cw - 1)
        level: s32
        if index == eob - 1 {
            at := eob_cdfs + CoefficientEOBContext(width, height, index) * 4
            level = DecodeSymbol(decoder, cdfs.values[at:at + 4]) + 1
        } else {
            at := base_cdfs + CoefficientBaseContext(levels, stride, row, column, width, height, tx_class) * 5
            level = DecodeSymbol(decoder, cdfs.values[at:at + 5])
        }
        if decoder.error.code != DecodeOK { return CoefficientSummaryFailure(decoder.error) }
        if level > 2 {
            at := br_cdfs + CoefficientBrContext(levels, stride, row, column, tx_class) * 5
            for extension: 0..3 {
                value := DecodeSymbol(decoder, cdfs.values[at:at + 5])
                if decoder.error.code != DecodeOK { return CoefficientSummaryFailure(decoder.error) }
                level += value
                if value < 3 { break }
            }
        }
        levels[row * stride + column] = cast(u8)level
        // Written for every level, kept only for a nonzero one.
        nonzero[nonzero_count] = cast(u16)index; nonzero_count += ifx level != 0 then 1 else 0
        index -= 1
    }
    // Signs and the larger levels follow in scan order, for nonzero levels only.
    k := nonzero_count - 1
    while k >= 0 {
        i := cast(s32)nonzero[k]
        position := cast(s32)positions[i]
        nonzero[k] = cast(u16)position; k -= 1
        level := cast(s32)levels[(position >> log_width) * stride + (position & (cw - 1))]
        sign: s32
        if i == 0 {
            at := 195 + (plane * 3 + dc_context) * 3
            sign = DecodeSymbol(decoder, cdfs.values[at:at + 3])
        } else { sign = cast(s32)ReadBool(decoder) }
        if level > 14 {
            // Normative20-bit limit includes the terminating length bit.
            length: s32
            while ReadBool(decoder) == 0 && decoder.error.code == DecodeOK {
                length += 1
                if length >= 20 { return CoefficientSummaryFailure(Error(MalformedInput, RangeByte(decoder))) }
            }
            extra := (cast(u32)1 << cast(u32)length) | ReadLiteral(decoder, length)
            level = cast(s32)(extra + 14)
        }
        if decoder.error.code != DecodeOK { return CoefficientSummaryFailure(decoder.error) }
        if position == 0 { result.dc_category = ifx sign == 1 then 1 else 2 }
        level &= 1048575; result.level += level
        quant[position] = ifx sign == 1 then -level else level
    }
    error = CancellationError(cancellation)
    if error.code != DecodeOK { return CoefficientSummaryFailure(error) }
    if result.level > 63 { result.level = 63 }
    result.eob = eob; result.coded_width = cw; result.coded_height = ch; result.nonzero = nonzero_count
    return result
}
