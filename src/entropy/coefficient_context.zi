using Codec :: #import "image_codec/api"

CoefficientClass2D :: 0
CoefficientClassHorizontal :: 1
CoefficientClassVertical :: 2
CoefficientContexts :: struct { base: s32; br: s32; error: DecodeError; }

// Coefficient levels padded with four zero columns on the right and four zero
// rows below the coded rectangle, so every neighbor read stays in range.
CoefficientLevelStride :: (coded_width: s32) -> s32 { return coded_width + 4 }

// A level as the context selection keeps it, as in dav1d: min(level, 3) in
// the top two bits and min(level, 15) below. A sum of five neighbors then
// gives the base magnitude in its top bits, and of three the BR magnitude in
// its low six bits, which hold at most 45.
CoefficientPackedLevel :: (level: s32) -> u8 #inline {
    return cast(u8)(((ifx level < 3 then level else 3) << 6) | (ifx level < 15 then level else 15))
}

// The base context's magnitude part from the packed sum of five neighbors:
// min((sum of min(level, 3) + 1) / 2, 4). Their min(level, 15) parts stay
// below 64 while that sum is at most 7, so they never carry into the result.
CoefficientBaseMagnitude :: (sum: u32) -> s32 #inline {
    return ifx sum > 512 then 4 else cast(s32)((sum + 64) >> 7)
}

// The BR context's magnitude part from the packed sum of three neighbors.
CoefficientBrMagnitude :: (sum: u32) -> s32 #inline {
    magnitude := cast(s32)(sum & 63)
    return ifx magnitude > 12 then 6 else (magnitude + 1) >> 1
}

// AV1 coefficient-base/base-eob/BR CDF selection. Class values are the AV1
// 2D/horizontal/vertical classes, not the row/column scan-mode constants.
// base indexes the selected base-eob CDF(0..3) when is_eob, otherwise base CDF.
// Caller-owned levels are unsigned coefficient magnitudes in compact row-major
// storage, zero outside the coded rectangle. This is context selection,
// without entropy/CDF mutation. A frame/tile caller must validate
// transform-set legality and provide matching scan_index/position; every
// normative scan begins at position0.
GetCoefficientContexts :: (levels: []u8, width: s32, height: s32, position: s32,
    scan_index: s32, tx_class: s32, is_eob: bool,
    cancellation: *Cancellation = null) -> CoefficientContexts {
    result: CoefficientContexts
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    if (width != 4 && width != 8 && width != 16 && width != 32 && width != 64) ||
        (height != 4 && height != 8 && height != 16 && height != 32 && height != 64) {
        result.error = Error(InvalidInput); return result
    }
    if width > height * 4 || height > width * 4 || tx_class < 0 || tx_class > 2 ||
        (tx_class != 0 && (width > 16 || height > 16)) {
        result.error = Error(InvalidInput); return result
    }
    cw := ifx width < 32 then width else 32; ch := ifx height < 32 then height else 32
    count := cw * ch
    if levels.count != cast(s64)count || position < 0 || position >= count || scan_index < 0 ||
        scan_index >= count || ((position == 0) != (scan_index == 0)) {
        result.error = Error(InvalidInput); return result
    }
    stride := CoefficientLevelStride(cw)
    padded: [1296]u8
    for r: 0..ch - 1 { for c: 0..cw - 1 { padded[r * stride + c] = CoefficientPackedLevel(cast(s32)levels[r * cw + c]) } }
    contexts := CoefficientContextsAt(padded[:], stride, position / cw, position % cw,
        width, height, scan_index, tx_class, is_eob)
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    result.base = contexts.base; result.br = contexts.br
    return result
}

// The selection itself, over packed padded levels at a validated coded position.
CoefficientContextsAt :: (levels: []u8, stride: s32, row: s32, column: s32,
    width: s32, height: s32, scan_index: s32, tx_class: s32, is_eob: bool) -> CoefficientContexts {
    result: CoefficientContexts
    at := cast(s64)row * stride + column
    near := CoefficientNearSum(levels, at, stride, tx_class)
    if is_eob { result.base = CoefficientEOBContext(width, height, scan_index) }
    else if tx_class == CoefficientClass2D && row == 0 && column == 0 { result.base = 0 }
    else {
        result.base = CoefficientBaseOffset(row, column, width, height, tx_class) +
            CoefficientBaseMagnitude(near + CoefficientFarSum(levels, at, stride, tx_class))
    }
    result.br = CoefficientBrContext(near, row, column, tx_class)
    return result
}

// The base context of the last coefficient, from its scan index alone.
CoefficientEOBContext :: (width: s32, height: s32, scan_index: s32) -> s32 {
    cw := ifx width < 32 then width else 32; ch := ifx height < 32 then height else 32
    count := cw * ch
    return ifx scan_index == 0 then 0 else ifx scan_index <= count / 8 then 1 else ifx scan_index <= count / 4 then 2 else 3
}

// The 2D base-context offset of AV1 get_coeff_base_ctx, which tests row and
// column only below 4: by shape (square, taller than wide, wider than tall),
// then min(row, 4) and min(column, 4). Position (0, 0) has context 0.
BaseContextOffsets2D :: u8.[
    0,1,6,6,21,1,6,6,21,21,6,6,21,21,21,6,21,21,21,21,21,21,21,21,21,
    0,11,11,11,11,11,11,11,11,11,6,6,21,21,21,6,21,21,21,21,21,21,21,21,21,
    0,16,6,6,21,16,16,6,21,21,16,16,21,21,21,16,16,21,21,21,16,16,21,21,21
]

// The packed sum of the three neighbors both contexts read: right and below,
// then below-right (2D), two right (horizontal) or two below (vertical).
CoefficientNearSum :: (levels: []u8, at: s64, stride: s32, tx_class: s32) -> u32 #inline {
    third := (ifx tx_class == CoefficientClass2D then cast(s64)stride + 1 else
        ifx tx_class == CoefficientClassHorizontal then 2 else 2 * cast(s64)stride)
    return cast(u32)levels[at + 1] + cast(u32)levels[at + stride] + cast(u32)levels[at + third]
}

// The packed sum of the two further neighbors only the base context reads:
// two right and two below (2D), or three and four along the class.
CoefficientFarSum :: (levels: []u8, at: s64, stride: s32, tx_class: s32) -> u32 #inline {
    step := ifx tx_class == CoefficientClassVertical then cast(s64)stride else 1
    if tx_class == CoefficientClass2D { return cast(u32)levels[at + 2] + cast(u32)levels[at + 2 * cast(s64)stride] }
    return cast(u32)levels[at + 3 * step] + cast(u32)levels[at + 4 * step]
}

// The base context's position offset, except 2D position (0, 0), which has
// context 0 whatever its neighbors. A table replaces the specification's
// chain of position tests, which mispredict along a scan.
CoefficientBaseOffset :: (row: s32, column: s32, width: s32, height: s32, tx_class: s32) -> s32 #inline {
    if tx_class == CoefficientClass2D {
        shape := ifx width == height then 0 else ifx width < height then 25 else 50
        near_row := ifx row < 4 then row else 4; near_column := ifx column < 4 then column else 4
        return cast(s32)BaseContextOffsets2D[shape + near_row * 5 + near_column]
    }
    index := ifx tx_class == CoefficientClassVertical then row else column
    return 26 + 5 * (ifx index < 2 then index else 2)
}

// The base-range context from the near sum; decoders need it only for
// levels above 2.
CoefficientBrContext :: (near: u32, row: s32, column: s32, tx_class: s32) -> s32 #inline {
    br := CoefficientBrMagnitude(near)
    if row == 0 && column == 0 { return br }
    close := (ifx tx_class == CoefficientClass2D then row < 2 && column < 2 else
        ifx tx_class == CoefficientClassHorizontal then column == 0 else row == 0)
    return br + (ifx close then 7 else 14)
}
