using Codec :: #import "image_codec/api"

CoefficientClass2D :: 0
CoefficientClassHorizontal :: 1
CoefficientClassVertical :: 2
CoefficientContexts :: struct { base: s32; br: s32; error: DecodeError; }

// Coefficient levels padded with four zero columns on the right and four zero
// rows below the coded rectangle, so every neighbor read stays in range.
CoefficientLevelStride :: (coded_width: s32) -> s32 { return coded_width + 4 }

CoefficientLevel :: (levels: []u8, at: s32, limit: s32) -> s32 {
    value := cast(s32)levels[at]
    return ifx value < limit then value else limit
}

// AV1 coefficient-base/base-eob/BR CDF selection. Class values are the AV1
// 2D/horizontal/vertical classes, not the row/column scan-mode constants.
// base indexes the selected base-eob CDF(0..3) when is_eob, otherwise base CDF.
// Caller-owned levels are unsigned coefficient magnitudes in compact row-major
// storage, zero outside the coded rectangle. This is context selection,
// without entropy/CDF mutation. A frame/tile caller must validate
// transform-set legality and provide matching scan_index/position; every
// normative scan begins at position0.
GetCoefficientContexts :: (levels: []u8, width: s32, height: s32, position: s32,
    scan_index: s32, tx_class: s32, is_eob: bool,
    cancellation: *Cancellation = null) -> CoefficientContexts {
    result: CoefficientContexts
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    if (width != 4 && width != 8 && width != 16 && width != 32 && width != 64) ||
        (height != 4 && height != 8 && height != 16 && height != 32 && height != 64) {
        result.error = Error(InvalidInput); return result
    }
    if width > height * 4 || height > width * 4 || tx_class < 0 || tx_class > 2 ||
        (tx_class != 0 && (width > 16 || height > 16)) {
        result.error = Error(InvalidInput); return result
    }
    cw := ifx width < 32 then width else 32; ch := ifx height < 32 then height else 32
    count := cw * ch
    if levels.count != cast(s64)count || position < 0 || position >= count || scan_index < 0 ||
        scan_index >= count || ((position == 0) != (scan_index == 0)) {
        result.error = Error(InvalidInput); return result
    }
    stride := CoefficientLevelStride(cw)
    padded: [1296]u8
    for r: 0..ch - 1 { for c: 0..cw - 1 { padded[r * stride + c] = levels[r * cw + c] } }
    contexts := CoefficientContextsAt(padded[:], stride, position / cw, position % cw,
        width, height, scan_index, tx_class, is_eob)
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    result.base = contexts.base; result.br = contexts.br
    return result
}

// The selection itself, over padded levels at a validated coded position.
CoefficientContextsAt :: (levels: []u8, stride: s32, row: s32, column: s32,
    width: s32, height: s32, scan_index: s32, tx_class: s32, is_eob: bool) -> CoefficientContexts {
    result: CoefficientContexts
    if is_eob { result.base = CoefficientEOBContext(width, height, scan_index) }
    else { result.base = CoefficientBaseContext(levels, stride, row, column, width, height, tx_class) }
    result.br = CoefficientBrContext(levels, stride, row, column, tx_class)
    return result
}

// The base context of the last coefficient, from its scan index alone.
CoefficientEOBContext :: (width: s32, height: s32, scan_index: s32) -> s32 {
    cw := ifx width < 32 then width else 32; ch := ifx height < 32 then height else 32
    count := cw * ch
    return ifx scan_index == 0 then 0 else ifx scan_index <= count / 8 then 1 else ifx scan_index <= count / 4 then 2 else 3
}

// The 2D base-context offset of AV1 get_coeff_base_ctx, which tests row and
// column only below 4: by shape (square, taller than wide, wider than tall),
// then min(row, 4) and min(column, 4). Position (0, 0) has context 0.
BaseContextOffsets2D :: u8.[
    0,1,6,6,21,1,6,6,21,21,6,6,21,21,21,6,21,21,21,21,21,21,21,21,21,
    0,11,11,11,11,11,11,11,11,11,6,6,21,21,21,6,21,21,21,21,21,21,21,21,21,
    0,16,6,6,21,16,16,6,21,21,16,16,21,21,21,16,16,21,21,21,16,16,21,21,21
]

// The base context of any other coefficient, from the levels after it.
CoefficientBaseContext :: (levels: []u8, stride: s32, row: s32, column: s32,
    width: s32, height: s32, tx_class: s32) -> s32 {
    at := row * stride + column
    magnitude := CoefficientLevel(levels, at + 1, 3) + CoefficientLevel(levels, at + stride, 3)
    if tx_class == CoefficientClass2D {
        magnitude += CoefficientLevel(levels, at + stride + 1, 3) + CoefficientLevel(levels, at + 2, 3) +
            CoefficientLevel(levels, at + 2 * stride, 3)
    } else if tx_class == CoefficientClassHorizontal {
        magnitude += CoefficientLevel(levels, at + 2, 3) + CoefficientLevel(levels, at + 3, 3) +
            CoefficientLevel(levels, at + 4, 3)
    } else {
        magnitude += CoefficientLevel(levels, at + 2 * stride, 3) + CoefficientLevel(levels, at + 3 * stride, 3) +
            CoefficientLevel(levels, at + 4 * stride, 3)
    }
    base := (magnitude + 1) >> 1
    if base > 4 { base = 4 }
    if tx_class == CoefficientClass2D {
        if row == 0 && column == 0 { return 0 }
        // A table instead of the specification's chain of position tests,
        // which mispredict along a scan.
        shape := ifx width == height then 0 else ifx width < height then 25 else 50
        near_row := ifx row < 4 then row else 4; near_column := ifx column < 4 then column else 4
        return base + cast(s32)BaseContextOffsets2D[shape + near_row * 5 + near_column]
    }
    index := ifx tx_class == CoefficientClassVertical then row else column
    return base + (ifx index == 0 then 26 else ifx index == 1 then 31 else 36)
}

// The base-range context; decoders need it only for levels above 2.
CoefficientBrContext :: (levels: []u8, stride: s32, row: s32, column: s32, tx_class: s32) -> s32 {
    at := row * stride + column
    magnitude := CoefficientLevel(levels, at + 1, 15) + CoefficientLevel(levels, at + stride, 15)
    if tx_class == CoefficientClass2D { magnitude += CoefficientLevel(levels, at + stride + 1, 15) }
    else if tx_class == CoefficientClassHorizontal { magnitude += CoefficientLevel(levels, at + 2, 15) }
    else { magnitude += CoefficientLevel(levels, at + 2 * stride, 15) }
    br := (magnitude + 1) >> 1
    if br > 6 { br = 6 }
    if row == 0 && column == 0 { return br }
    near := ifx tx_class == CoefficientClass2D then row < 2 && column < 2 else ifx tx_class == CoefficientClassHorizontal then column == 0 else row == 0
    return br + (ifx near then 7 else 14)
}
