#import, file "../syntax/bits.zi";

// Scalar AV1 8.2 symbol decoder. CDFs use the specification's ascending Q15
// convention, unlike libaom/dav1d's inverse CDF representation. Entropy literals
// must use ReadLiteral, not ReadBits. Virtual padding is bounded by exit_symbol.
RangeDecoder :: struct {
    input: BorrowedBytes;
    begin: s64;
    end: s64;
    // The next input byte for the window; the end once all are loaded.
    next: s64;
    // The specification's SymbolValue in bits 63..48, then count more input
    // bits, complemented. Past the end they are ones, the complemented zero
    // padding, so a renormalization only shifts and loads whole bytes.
    window: u64;
    count: s32;
    range: u32;
    max_bits: s64;
    disable_cdf_update: bool;
    initialized: bool;
    finished: bool;
    error: DecodeError;
}

NewRange :: (input: BorrowedBytes, begin: s64, end: s64, disable_cdf_update: bool = false) -> RangeDecoder {
    decoder: RangeDecoder
    decoder.input = input; decoder.begin = begin; decoder.end = end; decoder.next = begin
    if begin < 0 || end < begin || end > input.data.count { decoder.error = Error(InvalidInput, begin); return decoder }
    if end == begin { decoder.error = Error(TruncatedInput, end); return decoder }
    if end - begin > 1152921504606846975 { decoder.error = Error(LimitExceeded, begin); return decoder }
    // The first 15 bits go just below the top bit: SymbolValue starts as
    // 32767 minus them.
    decoder.count = -15
    RangeFill(*decoder)
    decoder.range = 32768
    decoder.max_bits = (end - begin) * 8 - 15
    decoder.disable_cdf_update = disable_cdf_update; decoder.initialized = true
    return decoder
}

// Loads input bytes below the window's bits while another whole byte fits.
RangeFill :: (decoder: *RangeDecoder) {
    data := decoder.input.data
    while decoder.count <= 40 {
        byte: u64 = 0
        if decoder.next < decoder.end { byte = cast(u64)data[decoder.next]; decoder.next += 1 }
        decoder.window |= (byte ^ 255) << cast(u64)(40 - decoder.count)
        decoder.count += 8
    }
}

// Where the specification's bit reader stands, as a bit offset into the
// input: renormalization has read all but max_bits of the interval.
RangeBitPosition :: (decoder: *RangeDecoder) -> s64 {
    if !decoder.initialized { return decoder.begin * 8 }
    if decoder.finished { return decoder.end * 8 }
    return decoder.end * 8 - (ifx decoder.max_bits > 0 then decoder.max_bits else 0)
}

// The byte of RangeBitPosition, for error offsets.
RangeByte :: (decoder: *RangeDecoder) -> s64 { return RangeBitPosition(decoder) >> 3 }

// Whether cdf has N probabilities followed by the adaptation counter,
// 2 <= N <= 16: each value lies in [0,32768], is nondecreasing, cdf[N-1] is
// 32768 and the counter is at most 32.
ValidCdf :: (cdf: []u16) -> bool {
    if cdf.count < 3 || cdf.count > 17 { return false }
    n := cast(s32)cdf.count - 1
    previous: u16
    i: s32
    while i < n {
        if cdf[i] < previous || cdf[i] > 32768 { return false }
        previous = cdf[i]; i += 1
    }
    return previous == 32768 && cdf[n] <= 32
}

// A symbol from a caller's cdf, which must be valid.
ReadSymbol :: (decoder: *RangeDecoder, cdf: []u16) -> s32 {
    if decoder.error.code != DecodeOK { return 0 }
    if cdf.count < 3 || cdf.count > 17 { decoder.error = Error(InvalidInput, RangeByte(decoder)); return 0 }
    if !RangeReady(decoder) { return 0 }
    if !ValidCdf(cdf) { decoder.error = Error(InvalidInput, RangeByte(decoder)); return 0 }
    return DecodeSymbol(decoder, cdf)
}

// ReadSymbol without the CDF scan, for decoder-owned CDFs. Those start from
// the normative tables and adaptation keeps them valid, so only the decoder
// state is checked here.
DecodeSymbol :: (decoder: *RangeDecoder, cdf: []u16) -> s32 {
    if decoder.error.code != DecodeOK { return 0 }
    if cdf.count < 3 || cdf.count > 17 { decoder.error = Error(InvalidInput, RangeByte(decoder)); return 0 }
    if !RangeReady(decoder) { return 0 }
    n := cast(s32)cdf.count - 1
    value := cast(u32)(decoder.window >> 48)
    cur := decoder.range
    prev: u32
    symbol: s32
    while symbol < n {
        prev = cur
        f := 32768 - cast(u32)cdf[symbol]
        cur = ((decoder.range >> 8) * (f >> 6)) >> 1
        cur += cast(u32)(4 * (n - symbol - 1))
        if value >= cur { break }
        symbol += 1
    }
    decoder.range = prev - cur; decoder.window -= cast(u64)cur << 48
    RangeRenormalize(decoder)
    if decoder.error.code != DecodeOK { return 0 }
    if !decoder.disable_cdf_update { AdaptCdf(cdf, n, symbol) }
    return symbol
}

// The adaptation of 8.2.6 after decoding symbol from the n-symbol cdf.
AdaptCdf :: (cdf: []u16, n: s32, symbol: s32) {
    if n < 0 || cast(s64)n >= cdf.count { return }
    rate: s32 = 3
    if cdf[n] > 15 { rate += 1 }
    if cdf[n] > 31 { rate += 1 }
    rate += ifx n < 4 then 1 else 2
    i: s32
    while i < n - 1 {
        current := cast(u32)cdf[i]
        if i < symbol { current -= current >> cast(u32)rate }
        else { current += (32768 - current) >> cast(u32)rate }
        cdf[i] = cast(u16)current; i += 1
    }
    if cdf[n] < 32 { cdf[n] += 1 }
}

// Valid state before a symbol; otherwise records the error.
RangeReady :: (decoder: *RangeDecoder) -> bool {
    if !decoder.initialized || decoder.finished || decoder.count < 15 || decoder.count > 48 ||
        decoder.range < 32768 || decoder.range > 65535 || cast(u32)(decoder.window >> 48) >= decoder.range {
        decoder.error = Error(InvalidInput, RangeByte(decoder)); return false
    }
    if decoder.max_bits < -14 { decoder.error = Error(TruncatedInput, decoder.end); return false }
    return true
}

// AV1 8.2.6 renormalization after the range shrank to the decoded symbol.
RangeRenormalize :: (decoder: *RangeDecoder) {
    // The range is below 65536, so its leading zeros past 16 are the shift.
    shifts := cast(s32)clz(decoder.range) - 16
    // No shift reads nothing and leaves the value: the state stays valid.
    if shifts == 0 { return }
    decoder.range <<= cast(u32)shifts
    // A symbol starts with at least 15 bits below the value, and a shift is at
    // most 15.
    decoder.window <<= cast(u64)shifts; decoder.count -= shifts
    if decoder.count < 15 { RangeFill(decoder) }
    decoder.max_bits -= shifts
    if decoder.max_bits < -14 { decoder.error = Error(TruncatedInput, decoder.end) }
}

// The fixed CDF {16384, 32768}: f is 16384, so the zero symbol's lower bound
// is ((range >> 8) << 7) + 4 and the one symbol keeps the range below it.
ReadBool :: (decoder: *RangeDecoder) -> u32 {
    if decoder.error.code != DecodeOK { return 0 }
    if !RangeReady(decoder) { return 0 }
    cur := ((decoder.range >> 8) << 7) + 4
    symbol: u32
    if cast(u32)(decoder.window >> 48) >= cur { decoder.range -= cur; decoder.window -= cast(u64)cur << 48 }
    else { decoder.range = cur; symbol = 1 }
    RangeRenormalize(decoder)
    if decoder.error.code != DecodeOK { return 0 }
    return symbol
}

ReadLiteral :: (decoder: *RangeDecoder, count: s32) -> u32 {
    if decoder.error.code != DecodeOK { return 0 }
    if count < 0 || count > 32 { decoder.error = Error(InvalidInput, RangeByte(decoder)); return 0 }
    value: u32
    i: s32
    while i < count && decoder.error.code == DecodeOK { value = (value << 1) | ReadBool(decoder); i += 1 }
    if decoder.error.code != DecodeOK { return 0 }
    return value
}

FinishRange :: (decoder: *RangeDecoder) -> DecodeError {
    if decoder.error.code != DecodeOK { return decoder.error }
    if !decoder.initialized || decoder.finished { decoder.error = Error(InvalidInput, RangeByte(decoder)); return decoder.error }
    if decoder.max_bits < -14 { decoder.error = Error(TruncatedInput, decoder.end); return decoder.error }
    position := RangeBitPosition(decoder) - decoder.begin * 8
    rewind := ifx decoder.max_bits >= 0 then 15 else decoder.max_bits + 15
    trailing := position - rewind
    if trailing < 0 { decoder.error = Error(MalformedInput, decoder.begin); return decoder.error }
    tail := NewBits(decoder.input, decoder.begin + trailing / 8, decoder.end)
    tail.bit = cast(s32)(trailing % 8)
    decoder.error = FinishBits(*tail)
    if decoder.error.code == DecodeOK { decoder.finished = true }
    return decoder.error
}
