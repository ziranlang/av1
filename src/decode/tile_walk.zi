// Partition tree, loop restoration unit syntax and tile walk, specification
// 5.11.4, 5.11.57-5.11.58 and 7.3.
DecodeIntraBlock :: (tile: *IntraTile, row: s32, column: s32, width: s32, height: s32) -> DecodeError {
    frame := tile.frame
    error := CancellationError(tile.cancellation)
    if error.code != DecodeOK { return error }
    // Subsampled_Size marks portrait luma blocks invalid in 4:2:2.
    if frame.planes > 1 && frame.subsampling_x == 1 && frame.subsampling_y == 0 && height > width {
        return Error(MalformedInput, RangeByte(*tile.decoder))
    }
    block: IntraBlock
    block.row = row; block.column = column; block.width = width; block.height = height
    block.bw4 = width >> 2; block.bh4 = height >> 2
    if block.bh4 == 1 && frame.subsampling_y != 0 && (row & 1) == 0 { block.has_chroma = false }
    else if block.bw4 == 1 && frame.subsampling_x != 0 && (column & 1) == 0 { block.has_chroma = false }
    else { block.has_chroma = frame.planes > 1 }
    block.avail_u = IntraInside(tile, row - 1, column); block.avail_l = IntraInside(tile, row, column - 1)
    if block.has_chroma {
        block.avail_u_chroma = block.avail_u; block.avail_l_chroma = block.avail_l
        if frame.subsampling_y != 0 && block.bh4 == 1 { block.avail_u_chroma = IntraInside(tile, row - 2, column) }
        if frame.subsampling_x != 0 && block.bw4 == 1 { block.avail_l_chroma = IntraInside(tile, row, column - 2) }
    }
    error = ReadIntraModeInfo(tile, *block)
    if error.code != DecodeOK { return error }
    error = ReadIntraPaletteTokens(tile, *block)
    if error.code != DecodeOK { return error }
    error = ReadIntraTxSize(tile, *block)
    if error.code != DecodeOK { return error }
    if block.skip != 0 { IntraResetBlockContext(tile, *block) }
    row_end := IntraMin(row + block.bh4, frame.mi_rows); column_end := IntraMin(column + block.bw4, frame.mi_cols)
    for r: row..row_end - 1 {
        for c: column..column_end - 1 {
            at := IntraMiAt(frame, cast(s32)r, cast(s32)c)
            frame.mi[at + IntraMiYMode] = cast(u8)block.y_mode
            if block.has_chroma { frame.mi[at + IntraMiUVMode] = cast(u8)block.uv_mode }
        }
    }
    error = IntraResidual(tile, *block)
    if error.code != DecodeOK { return error }
    size := IntraPackSize(width, height); tx := IntraPackSize(block.tx_width, block.tx_height)
    for r: row..row_end - 1 {
        for c: column..column_end - 1 {
            at := IntraMiAt(frame, cast(s32)r, cast(s32)c)
            frame.mi[at + IntraMiSize] = size
            frame.mi[at + IntraMiSkip] = cast(u8)block.skip
            frame.mi[at + IntraMiTx] = tx
            frame.mi[at + IntraMiSegment] = cast(u8)block.segment_id
            frame.mi[at + IntraMiPaletteY] = cast(u8)tile.palette.count
            frame.mi[at + IntraMiPaletteUV] = cast(u8)tile.uv_palette.count
            for i: 0..3 { frame.mi[at + IntraMiDeltaLF + i] = cast(u8)(tile.delta_lf[i] + 64) }
        }
    }
    for c: column..column_end - 1 {
        for i: 0..tile.palette.count - 1 { frame.palette_lines[c * 8 + i] = tile.palette.colors[i] }
        for i: 0..tile.uv_palette.count - 1 { frame.palette_lines[(cast(s64)frame.mi_cols + c) * 8 + i] = tile.uv_palette.colors[i] }
    }
    left := 16 * cast(s64)frame.mi_cols
    for r: row..row_end - 1 {
        for i: 0..tile.palette.count - 1 { frame.palette_lines[left + r * 8 + i] = tile.palette.colors[i] }
        for i: 0..tile.uv_palette.count - 1 { frame.palette_lines[left + (cast(s64)frame.mi_rows + r) * 8 + i] = tile.uv_palette.colors[i] }
    }
    return Error(DecodeOK)
}

DecodeIntraPartition :: (tile: *IntraTile, row: s32, column: s32, side: s32) -> DecodeError {
    frame := tile.frame
    error := CancellationError(tile.cancellation)
    if error.code != DecodeOK { return error }
    if row >= frame.mi_rows || column >= frame.mi_cols { return Error(DecodeOK) }
    half4 := side >> 3; quarter4 := side >> 4
    has_rows := row + half4 < frame.mi_rows; has_cols := column + half4 < frame.mi_cols
    partition: s32
    if side > 4 {
        above_w: s32; left_h: s32
        if IntraInside(tile, row - 1, column) { above_w = IntraPackedWidth(frame.mi[IntraMiAt(frame, row - 1, column) + IntraMiSize]) }
        if IntraInside(tile, row, column - 1) { left_h = IntraPackedHeight(frame.mi[IntraMiAt(frame, row, column - 1) + IntraMiSize]) }
        if has_rows && has_cols { partition = ReadSquarePartition(*tile.decoder, *tile.cdfs.partitions, side, above_w, left_h) }
        else if has_cols { partition = ReadBoundaryPartition(*tile.decoder, *tile.cdfs.partitions, side, above_w, left_h, false) }
        else if has_rows { partition = ReadBoundaryPartition(*tile.decoder, *tile.cdfs.partitions, side, above_w, left_h, true) }
        else { partition = 3 }
        if tile.decoder.error.code != DecodeOK { return tile.decoder.error }
    }
    half := side / 2; quarter := side / 4
    if partition == 0 { return DecodeIntraBlock(tile, row, column, side, side) }
    if partition == 1 {
        error = DecodeIntraBlock(tile, row, column, side, half)
        if error.code != DecodeOK || !has_rows { return error }
        return DecodeIntraBlock(tile, row + half4, column, side, half)
    }
    if partition == 2 {
        error = DecodeIntraBlock(tile, row, column, half, side)
        if error.code != DecodeOK || !has_cols { return error }
        return DecodeIntraBlock(tile, row, column + half4, half, side)
    }
    if partition == 3 {
        error = DecodeIntraPartition(tile, row, column, half)
        if error.code != DecodeOK { return error }
        error = DecodeIntraPartition(tile, row, column + half4, half)
        if error.code != DecodeOK { return error }
        error = DecodeIntraPartition(tile, row + half4, column, half)
        if error.code != DecodeOK { return error }
        return DecodeIntraPartition(tile, row + half4, column + half4, half)
    }
    if partition == 4 {
        error = DecodeIntraBlock(tile, row, column, half, half)
        if error.code != DecodeOK { return error }
        error = DecodeIntraBlock(tile, row, column + half4, half, half)
        if error.code != DecodeOK { return error }
        return DecodeIntraBlock(tile, row + half4, column, side, half)
    }
    if partition == 5 {
        error = DecodeIntraBlock(tile, row, column, side, half)
        if error.code != DecodeOK { return error }
        error = DecodeIntraBlock(tile, row + half4, column, half, half)
        if error.code != DecodeOK { return error }
        return DecodeIntraBlock(tile, row + half4, column + half4, half, half)
    }
    if partition == 6 {
        error = DecodeIntraBlock(tile, row, column, half, half)
        if error.code != DecodeOK { return error }
        error = DecodeIntraBlock(tile, row + half4, column, half, half)
        if error.code != DecodeOK { return error }
        return DecodeIntraBlock(tile, row, column + half4, half, side)
    }
    if partition == 7 {
        error = DecodeIntraBlock(tile, row, column, half, side)
        if error.code != DecodeOK { return error }
        error = DecodeIntraBlock(tile, row, column + half4, half, half)
        if error.code != DecodeOK { return error }
        return DecodeIntraBlock(tile, row + half4, column + half4, half, half)
    }
    if (partition == 8 || partition == 9) && side >= 16 && side <= 64 {
        for i: 0..3 {
            if partition == 8 {
                r := row + quarter4 * cast(s32)i
                if i == 3 && r >= frame.mi_rows { break }
                error = DecodeIntraBlock(tile, r, column, side, quarter)
            } else {
                c := column + quarter4 * cast(s32)i
                if i == 3 && c >= frame.mi_cols { break }
                error = DecodeIntraBlock(tile, row, c, quarter, side)
            }
            if error.code != DecodeOK { return error }
        }
        return Error(DecodeOK)
    }
    return Error(MalformedInput, RangeByte(*tile.decoder))
}

IntraInverseRecenter :: (r: s32, v: s32) -> s32 {
    if v > 2 * r { return v }
    if (v & 1) != 0 { return r - ((v + 1) >> 1) }
    return r + (v >> 1)
}

IntraReadNS :: (decoder: *RangeDecoder, n: s32) -> s32 {
    if n <= 1 { return 0 }
    w: s32; x := n
    while x != 0 { x >>= 1; w += 1 }
    m := IntraShift(1, w) - n
    v := cast(s32)ReadLiteral(decoder, w - 1)
    if v < m { return v }
    return v * 2 - m + cast(s32)ReadLiteral(decoder, 1)
}

// decode_signed_subexp_with_ref_bool with arithmetic-coded bits.
IntraSubexpWithRef :: (decoder: *RangeDecoder, low: s32, high: s32, k: s32, reference: s32) -> s32 {
    mx := high - low; r := reference - low
    i: s32; mk: s32; v: s32
    while decoder.error.code == DecodeOK && i < 24 {
        b2 := ifx i != 0 then k + i - 1 else k
        a := IntraShift(1, b2)
        if mx <= mk + 3 * a { v = IntraReadNS(decoder, mx - mk) + mk; break }
        if ReadLiteral(decoder, 1) != 0 { i += 1; mk += a }
        else { v = cast(s32)ReadLiteral(decoder, b2) + mk; break }
    }
    x: s32
    if r * 2 <= mx { x = IntraInverseRecenter(r, v) }
    else { x = mx - 1 - IntraInverseRecenter(mx - 1 - r, v) }
    return x + low
}

ReadIntraRestorationUnit :: (tile: *IntraTile, plane: s32, unit_row: s32, unit_col: s32) -> DecodeError {
    frame := tile.frame
    kind: s32
    frame_type := frame.restoration_type[plane]
    if frame_type == 1 { kind = ifx ReadSymbol(*tile.decoder, tile.cdfs.wiener[:]) != 0 then 1 else 0 }
    else if frame_type == 2 { kind = ifx ReadSymbol(*tile.decoder, tile.cdfs.sgrproj[:]) != 0 then 2 else 0 }
    else { kind = ReadSymbol(*tile.decoder, tile.cdfs.restoration[:]) }
    if tile.decoder.error.code != DecodeOK { return tile.decoder.error }
    at := frame.restoration_offset[plane] + (cast(s64)unit_row * frame.restoration_columns[plane] + unit_col) * IntraRestorationFields
    frame.restoration[at] = cast(s16)kind
    if kind == 1 {
        minimum: [3]s32 = .[-5,-23,-17]; maximum: [3]s32 = .[10,8,46]; k: [3]s32 = .[1,2,3]
        for pass: 0..1 {
            first: s32 = ifx plane > 0 then 1 else 0
            if plane > 0 { frame.restoration[at + 1 + pass * 3] = 0 }
            for j: first..2 {
                reference := (plane * 2 + cast(s32)pass) * 3 + cast(s32)j
                v := IntraSubexpWithRef(*tile.decoder, minimum[j], maximum[j] + 1, k[j], tile.ref_wiener[reference])
                frame.restoration[at + 1 + pass * 3 + j] = cast(s16)v; tile.ref_wiener[reference] = v
            }
        }
    } else if kind == 2 {
        set := cast(s32)ReadLiteral(*tile.decoder, 4)
        frame.restoration[at + 7] = cast(s16)set
        minimum: [2]s32 = .[-96,-32]; maximum: [2]s32 = .[31,95]
        for i: 0..1 {
            v: s32
            if SgrParameters(set, cast(s32)i * 2) != 0 {
                v = IntraSubexpWithRef(*tile.decoder, minimum[i], maximum[i] + 1, 4, tile.ref_sgr[plane * 2 + cast(s32)i])
            } else if i == 1 {
                v = IntraMax(minimum[1], IntraMin(maximum[1], 128 - tile.ref_sgr[plane * 2]))
            }
            frame.restoration[at + 8 + i] = cast(s16)v; tile.ref_sgr[plane * 2 + cast(s32)i] = v
        }
    }
    return tile.decoder.error
}

ReadIntraRestoration :: (tile: *IntraTile, row: s32, column: s32) -> DecodeError {
    frame := tile.frame
    if tile.header.allow_intrabc { return Error(DecodeOK) }
    size4 := frame.superblock4
    for plane: 0..frame.planes - 1 {
        if frame.restoration_type[plane] == 0 { continue }
        sx := IntraSubX(frame, cast(s32)plane); sy := IntraSubY(frame, cast(s32)plane)
        unit := frame.restoration_size[plane]
        step_y := 4 >> sy; step_x := 4 >> sx
        row_start := (row * step_y + unit - 1) / unit
        row_end := IntraMin(frame.restoration_rows[plane], ((row + size4) * step_y + unit - 1) / unit)
        column_start := (column * step_x + unit - 1) / unit
        column_end := IntraMin(frame.restoration_columns[plane], ((column + size4) * step_x + unit - 1) / unit)
        for unit_row: row_start..row_end - 1 {
            for unit_col: column_start..column_end - 1 {
                error := ReadIntraRestorationUnit(tile, cast(s32)plane, cast(s32)unit_row, cast(s32)unit_col)
                if error.code != DecodeOK { return error }
            }
        }
    }
    return Error(DecodeOK)
}

IntraClearDecoded :: (tile: *IntraTile, row: s32, column: s32) {
    frame := tile.frame
    size4 := frame.superblock4
    for plane: 0..2 {
        sx := IntraSubX(frame, cast(s32)plane); sy := IntraSubY(frame, cast(s32)plane)
        width4 := (tile.column_end - column) >> sx; height4 := (tile.row_end - row) >> sy
        for y: -1..(size4 >> sy) {
            for x: -1..(size4 >> sx) {
                value: u8
                if y < 0 && x < width4 { value = 1 }
                else if x < 0 && y < height4 { value = 1 }
                tile.decoded[IntraDecodedAt(cast(s32)plane, cast(s32)y, cast(s32)x)] = value
            }
        }
        tile.decoded[IntraDecodedAt(cast(s32)plane, size4 >> sy, -1)] = 0
    }
}

DecodeIntraTile :: (tile: *IntraTile) -> DecodeError {
    frame := tile.frame
    for i: 0..frame.contexts.count - 1 { frame.contexts[i] = 0 }
    for i: 0..3 { tile.delta_lf[i] = 0 }
    for plane: 0..2 {
        for pass: 0..1 {
            tile.ref_sgr[plane * 2 + pass] = ifx pass == 0 then -32 else 31
            tile.ref_wiener[(plane * 2 + pass) * 3] = 3
            tile.ref_wiener[(plane * 2 + pass) * 3 + 1] = -7
            tile.ref_wiener[(plane * 2 + pass) * 3 + 2] = 15
        }
    }
    size4 := frame.superblock4
    row := tile.row_start
    while row < tile.row_end {
        for plane: 0..frame.planes - 1 {
            sy := IntraSubY(frame, cast(s32)plane)
            left := IntraContextBase(frame, cast(s32)plane) + 2 * cast(s64)frame.context_columns
            for i: (row >> sy)..((row + size4) >> sy) - 1 {
                frame.contexts[left + i] = 0; frame.contexts[left + frame.context_rows + i] = 0
            }
        }
        column := tile.column_start
        while column < tile.column_end {
            error := CancellationError(tile.cancellation)
            if error.code != DecodeOK { return error }
            tile.read_deltas = tile.header.delta_q_present
            for dy: 0..(size4 / 16) - 1 {
                for dx: 0..(size4 / 16) - 1 {
                    r := (row >> 4) + cast(s32)dy; c := (column >> 4) + cast(s32)dx
                    if r < frame.cdef_rows && c < frame.cdef_columns { frame.cdef[cast(s64)r * frame.cdef_columns + c] = 0 }
                }
            }
            IntraClearDecoded(tile, row, column)
            error = ReadIntraRestoration(tile, row, column)
            if error.code != DecodeOK { return error }
            error = DecodeIntraPartition(tile, row, column, size4 * 4)
            if error.code != DecodeOK { return error }
            column += size4
        }
        row += size4
    }
    return Error(DecodeOK)
}

// Decode the tiles of one tile group span; frame.tiles_decoded accumulates
// across groups and the caller requires it to reach columns*rows. Each tile
// starts from the default probabilities for base_q_idx.
DecodeIntraFrameTiles :: (frame: *IntraFrame, samples: []u16, sequence: *SequenceHeader,
    header: *StillFrameHeader, input: BorrowedBytes, begin: s64, end: s64,
    cancellation: *Cancellation = null, whole_frame: bool = false) -> DecodeError {
    if frame == null || sequence == null || header == null || samples.count != frame.sample_count { return Error(InvalidInput) }
    cdfs := NewIntraTileCDFs(header.base_q_idx, cancellation)
    if cdfs.error.code != DecodeOK { return cdfs.error }
    group := NewTileGroup(input, begin, end, header.tiles, cancellation, whole_frame)
    if group.error.code != DecodeOK { return group.error }
    tile: IntraTile
    tile.frame = frame; tile.samples = samples; tile.sequence = sequence; tile.header = header; tile.cancellation = cancellation
    while true {
        span := NextTileSpan(*group)
        if span.error.code != DecodeOK { return span.error }
        if !span.has_tile { break }
        // Tile groups continue in tile order: tg_start follows the last tile.
        if span.tile.index != frame.tiles_decoded { return Error(MalformedInput, span.tile.begin) }
        if span.tile.row < 0 || span.tile.row >= header.tiles.rows || span.tile.column < 0 || span.tile.column >= header.tiles.columns {
            return Error(MalformedInput, span.tile.begin)
        }
        tile.cdfs = cdfs
        tile.row_start = header.tiles.row_starts[span.tile.row]; tile.row_end = header.tiles.row_starts[span.tile.row + 1]
        tile.column_start = header.tiles.column_starts[span.tile.column]; tile.column_end = header.tiles.column_starts[span.tile.column + 1]
        if tile.row_start < 0 || tile.row_end > frame.mi_rows || tile.row_start >= tile.row_end ||
            tile.column_start < 0 || tile.column_end > frame.mi_cols || tile.column_start >= tile.column_end {
            return Error(MalformedInput, span.tile.begin)
        }
        tile.current_q = header.base_q_idx
        tile.decoder = NewRange(input, span.tile.begin, span.tile.end, header.disable_cdf_update)
        if tile.decoder.error.code != DecodeOK { return tile.decoder.error }
        error := DecodeIntraTile(*tile)
        if error.code != DecodeOK { return error }
        error = FinishRange(*tile.decoder)
        if error.code != DecodeOK { return error }
        frame.tiles_decoded += 1
        if frame.tiles_decoded > header.tiles.columns * header.tiles.rows { return Error(MalformedInput, span.tile.begin) }
    }
    return CancellationError(cancellation)
}
